---
import '@fontsource-variable/atkinson-hyperlegible-next';
import '@fontsource-variable/atkinson-hyperlegible-mono';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/silkscreen';
import '../styles/global.css';
import Rouage from '../components/Rouage.astro';

interface Props {
  title?: string;
  description?: string;
  indexer?: boolean; // false : page exclue de la recherche (Pagefind)
}

const {
  title,
  description = "Internet, l'informatique et l'IA expliqués de manière animée, sans masquer la vraie technologie.",
  indexer = true,
} = Astro.props;
const fullTitle = title ? `${title} · Les rouages du net` : 'Les rouages du net';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title="Les rouages du net · Revues de veille" href="/veille/revues.xml" />
    <script is:inline>
      // Mode de lecture des modules (src/lib/ecrans.ts), posé avant l'affichage.
      try {
        document.documentElement.dataset.lecture = localStorage.getItem('rouages-lecture') === 'continu' ? 'continu' : 'ecrans';
      } catch (e) {
        document.documentElement.dataset.lecture = 'ecrans';
      }
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap entete">
        <a href="/" class="logo" data-logo><Rouage />Les rouages du net<span class="curseur" aria-hidden="true"></span></a>
        <nav aria-label="Navigation principale"><a href="/ia/">L'IA</a> <a href="/notions/">Notions</a> <a href="/glossaire/">Glossaire</a> <a href="/jeux/">Jeux</a> <a href="/veille/">Veille</a></nav>
        <form class="recherche-entete" action="/recherche/" method="get" role="search">
          <label for="recherche-entete" class="visuellement-cache">Rechercher sur le site</label>
          <input id="recherche-entete" type="search" name="q" placeholder="Rechercher…" autocomplete="off" />
          <button type="submit" aria-label="Lancer la recherche">🔍</button>
        </form>
      </div>
    </header>
    <main class="wrap" data-pagefind-body={indexer ? '' : undefined}>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>Les rouages du net — contenus sous licence CC BY-SA 4.0. Sans pistage, sans publicité.</p>
        <p class="clin">Fabriqué avec des rouages, des RFC et beaucoup de curiosité. Il paraît que des secrets se cachent ici et là… ↑ ↑ ↓ ↓</p>
      </div>
    </footer>
    <p class="clin-bulle" role="status" aria-live="polite" data-clin hidden></p>
    <script>
      import '../scripts/clins';
    </script>
  </body>
</html>
