---
// Le jeu Quêtes de Sysadmin, intégré depuis son propre site
// (https://sysadmin.rouages.net, dépôt Rouages-du-net/quetes-de-sysadmin) :
// aucun code du jeu n'est copié ici. La clé de sauvegarde « rouages-terminus »
// garde la progression des joueur·ses de l'ancienne page Terminus.
import Base from '../../../layouts/Base.astro';
import Sources from '../../../components/Sources.astro';
import MiseAJour from '../../../components/MiseAJour.astro';

const SCRIPT = 'https://sysadmin.rouages.net/integration/quetes-de-sysadmin.js';
---
<Base
  title="Quêtes de Sysadmin"
  description="Un jeu d'aventure pour apprendre les commandes Linux et l'administration système, directement dans le navigateur."
>
  <p class="tag"><a href="/jeux/">Jeux</a> › Quêtes de Sysadmin</p>
  <h1>Quêtes de Sysadmin</h1>
  <MiseAJour date="2026-10-18" />
  <p class="intro">
    Des aventures où l'on agit avec de <strong>vraies commandes Linux</strong>. Chaque lieu est un
    dossier, chaque objet un fichier. Cinq histoires indépendantes : commence par l'Effaceur si tu
    n'as jamais ouvert un terminal.
  </p>
  <p class="intro">
    Bloqué·e ? Fais comme les pros : <code>man commande</code> ouvre le manuel,
    <code>commande --help</code> en donne un résumé, et <code>man -k mot</code> cherche la commande
    qui fait ce que tu veux.
  </p>

  <noscript>
    <p class="anim-cadre">Ce jeu a besoin de JavaScript pour simuler un terminal dans ton navigateur.</p>
  </noscript>

  <quetes-de-sysadmin cle="rouages-terminus"></quetes-de-sysadmin>
  <script is:inline type="module" src={SCRIPT}></script>

  <p class="tag">
    Quêtes de Sysadmin est un projet libre né sur ce site sous le nom « Terminus en français », et
    devenu indépendant pour pouvoir s'intégrer partout : <a href="https://sysadmin.rouages.net">sysadmin.rouages.net</a>,
    <a href="https://github.com/Rouages-du-net/quetes-de-sysadmin">code source</a> (GPL v3, textes CC BY-SA 4.0).
    Il s'inspire de <a href="https://web.mit.edu/mprat/Public/web/Terminus/Web/main.html">Terminus</a>, créé au
    MIT par Shawn Conrad et Michele Pratusevich. Ta progression est gardée dans ce navigateur.
  </p>

  <Sources
    verifie="2026-10-18"
    sources={[
      { titre: 'Terminus, le jeu original', url: 'https://web.mit.edu/mprat/Public/web/Terminus/Web/main.html', type: 'site', auteur: 'Shawn Conrad, Michele Pratusevich (MIT)', langue: 'en' },
      { auteur: 'RFC Editor', titre: 'RFC 5737 — adresses IPv4 réservées à la documentation', url: 'https://www.rfc-editor.org/rfc/rfc5737', type: 'primaire', annee: 2010, langue: 'en' },
      { auteur: 'RFC Editor', titre: 'RFC 6761 — noms de domaine réservés (.example…)', url: 'https://www.rfc-editor.org/rfc/rfc6761', type: 'primaire', annee: 2013, langue: 'en' },
      { auteur: 'nginx', titre: 'Module ngx_http_access_module (directive deny)', url: 'https://nginx.org/en/docs/http/ngx_http_access_module.html', type: 'primaire', langue: 'en' },
      { auteur: 'Git', titre: 'Documentation de git (git-restore, git-log, git-diff…)', url: 'https://git-scm.com/docs', type: 'primaire', langue: 'en' },
      { auteur: 'Quad9', titre: 'Le résolveur DNS public 9.9.9.9', url: 'https://www.quad9.net/', type: 'site', langue: 'en' },
    ]}
  />
</Base>

<style>
  .intro { max-width: var(--mesure); }
  quetes-de-sysadmin {
    display: block;
    margin: 1.5rem 0;
    /* Couleurs du jeu accordées à la charte du site. */
    --qds-fond: var(--bg);
    --qds-carte: var(--card);
    --qds-texte: var(--fg);
    --qds-discret: var(--muted);
    --qds-bord: var(--border);
    --qds-accent: var(--accent);
    --qds-terminal-fond: var(--terminal-bg);
    --qds-terminal-texte: var(--terminal-fg);
    --qds-terminal-invite: var(--terminal-invite);
    --qds-police: var(--police);
    --qds-police-mono: var(--police-mono);
  }
</style>
