---
import Base from '../../../layouts/Base.astro';
import Sources from '../../../components/Sources.astro';
import MiseAJour from '../../../components/MiseAJour.astro';
import { HISTOIRES } from '../../../scripts/terminus/chapitres';

// Espaces insécables de la typographie française (avant : ; ! ? », après «).
const typo = (t: string) => t.replace(/« /g, '«\u00a0').replace(/ ([:;!?»])/g, '\u00a0$1');
---
<Base
  title="Terminus"
  description="Un jeu d'aventure pour apprendre les commandes Linux, directement dans le navigateur."
>
  <p class="tag"><a href="/jeux/">Jeux</a> › Terminus</p>
  <h1>Terminus <small class="tag">en français</small></h1>
  <MiseAJour date="2026-10-17" />
  <p class="intro">
    Des jeux d'aventure où l'on agit avec de <strong>vraies commandes Linux</strong>. Chaque
    lieu est un dossier, chaque objet un fichier. Cinq histoires indépendantes : commence par
    l'Effaceur si tu n'as jamais ouvert un terminal.
  </p>
  <p class="intro">
    Bloqué·e ? Fais comme les pros : <code>man commande</code> ouvre le manuel,
    <code>commande --help</code> en donne un résumé, et <code>man -k mot</code> cherche la
    commande qui fait ce que tu veux.
  </p>

  <noscript>
    <p class="anim-cadre">Ce jeu a besoin de JavaScript pour simuler un terminal dans ton navigateur.</p>
  </noscript>

  <nav class="histoires" aria-label="Histoires" hidden>
    <ol>
      {HISTOIRES.map((h, i) => (
        <li>
          <button type="button" data-histoire={i}>
            <span class="titre">{h.titre}</span>
            <span class="resume">{typo(h.resume)}</span>
            <span class="etat"></span>
          </button>
        </li>
      ))}
    </ol>
  </nav>

  {HISTOIRES.map((h, i) => h.chapitres.length > 1 && (
    <nav class="chapitres" aria-label={`Chapitres de « ${h.titre} »`} data-chapitres={i} hidden>
      <ol>
        {h.chapitres.map((c, j) => (
          <li>
            <button type="button" data-chapitre={j}>
              <span class="num">Chapitre {c.numero}</span>
              <span class="titre">{c.titre}</span>
              <span class="resume">{typo(c.resume)}</span>
              <span class="etat"></span>
            </button>
          </li>
        ))}
      </ol>
    </nav>
  ))}

  <div class="terminal" id="terminal">
    <div id="sortie" role="log" aria-live="polite"></div>
    <form id="formulaire" autocomplete="off">
      <label for="saisie" class="invite" id="invite"></label>
      <input id="saisie" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" />
    </form>
  </div>

  <div class="fin" id="fin" hidden>
    <button type="button" class="anim-bouton principal" id="suivant">Chapitre suivant →</button>
  </div>

  <p class="tag astuces">
    Astuces : <kbd>Tab</kbd> complète les noms, <kbd>↑</kbd> rappelle les commandes,
    <code>aide</code> liste celles que tu connais. Ta progression est gardée dans ce navigateur.
    <button type="button" class="lien" id="recommencer">Recommencer ce chapitre</button>
  </p>

  <p class="tag">
    L'Effaceur s'inspire de <a href="https://web.mit.edu/mprat/Public/web/Terminus/Web/main.html">Terminus</a>,
    créé au MIT par Shawn Conrad et Michele Pratusevich (en anglais) : l'idée d'apprendre les
    commandes en se déplaçant de dossier en dossier vient de là. Les lieux, les énigmes et les
    textes de toutes nos histoires sont écrits pour Les rouages du net. Les commandes répondent souvent en anglais, comme sur un vrai
    système ; les adresses et les noms de domaine utilisés sont réservés aux exemples.
  </p>

  <Sources
    verifie="2026-10-17"
    sources={[
      {
        titre: 'Terminus, le jeu original',
        url: 'https://web.mit.edu/mprat/Public/web/Terminus/Web/main.html',
        type: 'site',
        auteur: 'Shawn Conrad, Michele Pratusevich (MIT)',
        langue: 'en',
      },
      { auteur: 'RFC Editor', titre: 'RFC 5737 — adresses IPv4 réservées à la documentation', url: 'https://www.rfc-editor.org/rfc/rfc5737', type: 'primaire', annee: 2010, langue: 'en' },
      { auteur: 'RFC Editor', titre: 'RFC 6761 — noms de domaine réservés (.example…)', url: 'https://www.rfc-editor.org/rfc/rfc6761', type: 'primaire', annee: 2013, langue: 'en' },
      { auteur: 'nginx', titre: 'Module ngx_http_access_module (directive deny)', url: 'https://nginx.org/en/docs/http/ngx_http_access_module.html', type: 'primaire', langue: 'en' },
      { auteur: 'Git', titre: 'Documentation de git (git-restore, git-log, git-diff…)', url: 'https://git-scm.com/docs', type: 'primaire', langue: 'en' },
      { auteur: 'S. Chacon, B. Straub', titre: 'Pro Git — A Short History of Git', url: 'https://git-scm.com/book/en/v2/Getting-Started-A-Short-History-of-Git', type: 'site', langue: 'en' },
      { auteur: 'Quad9', titre: 'Le résolveur DNS public 9.9.9.9', url: 'https://www.quad9.net/', type: 'site', langue: 'en' },
    ]}
  />
</Base>

<style>
  .terminal {
    background: var(--terminal-bg);
    color: var(--terminal-fg);
    font: 0.95rem/1.5 var(--police-mono);
    border-radius: 0.75rem;
    padding: 1rem;
    min-height: 24rem;
    max-height: 70vh;
    overflow-y: auto;
    cursor: text;
  }
  #sortie :global(pre) { margin: 0 0 0.5rem; white-space: pre-wrap; word-break: break-word; font: inherit; }
  #sortie :global(.cmd) { color: color-mix(in oklab, var(--terminal-fg) 75%, var(--terminal-bg)); }
  form { display: flex; flex-wrap: wrap; gap: 0 0.5ch; }
  .invite { color: var(--terminal-invite); overflow-wrap: anywhere; }
  input {
    flex: 1;
    min-width: 12ch;
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    outline: none;
    caret-color: var(--terminal-fg);
  }
  .intro { max-width: var(--mesure); }
  .histoires ol, .chapitres ol {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .histoires button, .chapitres button {
    display: grid;
    gap: 0.15rem;
    width: 100%;
    height: 100%;
    text-align: left;
    font: inherit;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card);
    color: var(--fg);
  }
  .histoires button, .chapitres button { cursor: pointer; }
  .chapitres button:disabled { cursor: default; opacity: 0.6; }
  .histoires button[aria-current='true'], .chapitres button[aria-current='true'] { border: 2px solid var(--accent); }
  .chapitres ol { margin-top: -0.5rem; }
  .histoires ol { grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); }
  .chapitres button { background: var(--bg); }
  .num { font-size: 0.8rem; color: var(--muted); }
  .titre { font-weight: 700; }
  .resume { font-size: 0.9rem; color: var(--muted); }
  .etat { font-size: 0.85rem; font-weight: 600; color: var(--accent); }
  .fin { margin-top: 1rem; }
  @media (max-width: 40rem) {
    .histoires ol, .chapitres ol { grid-template-columns: 1fr 1fr; gap: 0.5rem; }
    .histoires .resume, .chapitres .resume { display: none; }
  }
  .astuces { margin-top: 1rem; }
  .lien { font: inherit; background: none; border: none; padding: 0; color: var(--accent); text-decoration: underline; cursor: pointer; }
  kbd { border: 1px solid var(--border); border-radius: 0.25rem; padding: 0 0.3em; font-size: 0.85em; }
</style>

<script>
  import { Shell } from '../../../scripts/terminus/shell';
  import { HISTOIRES } from '../../../scripts/terminus/chapitres';

  const CLE = 'rouages-terminus';
  const terminal = document.getElementById('terminal')!;
  const sortie = document.getElementById('sortie')!;
  const form = document.getElementById('formulaire') as HTMLFormElement;
  const saisie = document.getElementById('saisie') as HTMLInputElement;
  const invite = document.getElementById('invite')!;
  const fin = document.getElementById('fin')!;
  const navHistoires = document.querySelector<HTMLElement>('.histoires')!;
  const boutonsHistoires = [...navHistoires.querySelectorAll<HTMLButtonElement>('[data-histoire]')];

  // Progression gardée dans ce navigateur : chapitres terminés, histoire en cours.
  let termines: string[] = [];
  let histoire = 0;
  try {
    const sauve = JSON.parse(localStorage.getItem(CLE) ?? '{}');
    termines = sauve.termines ?? [];
    histoire = Math.max(0, HISTOIRES.findIndex((h) => h.id === sauve.histoire));
  } catch {}
  const sauver = () => {
    try {
      localStorage.setItem(CLE, JSON.stringify({ termines, histoire: HISTOIRES[histoire].id }));
    } catch {}
  };
  const chapitres = (h: number) => HISTOIRES[h].chapitres;
  const ouvert = (h: number, c: number) => c === 0 || termines.includes(chapitres(h)[c - 1].id);

  let shell: Shell;
  let courant = 0;
  const historique: string[] = [];
  let position = 0;

  const afficher = (texte: string, classe?: string) => {
    if (!texte) return;
    const pre = document.createElement('pre');
    pre.textContent = texte;
    if (classe) pre.className = classe;
    sortie.appendChild(pre);
  };

  const majInvite = () => {
    invite.textContent = shell.invite();
    saisie.type = shell.attente ? 'password' : 'text';
  };

  const majNav = () => {
    boutonsHistoires.forEach((b, h) => {
      b.setAttribute('aria-current', String(h === histoire));
      const faits = chapitres(h).filter((c) => termines.includes(c.id)).length;
      const total = chapitres(h).length;
      b.querySelector('.etat')!.textContent =
        faits === total ? '✓ Terminée' : total > 1 ? `${faits} chapitre${faits > 1 ? 's' : ''} sur ${total}` : '';
    });
    document.querySelectorAll<HTMLElement>('[data-chapitres]').forEach((nav) => {
      const h = Number(nav.dataset.chapitres);
      nav.hidden = h !== histoire;
      nav.querySelectorAll<HTMLButtonElement>('[data-chapitre]').forEach((b, c) => {
        b.disabled = !ouvert(h, c);
        b.setAttribute('aria-current', String(h === histoire && c === courant));
        b.querySelector('.etat')!.textContent = termines.includes(chapitres(h)[c].id)
          ? '✓ Terminé'
          : ouvert(h, c)
            ? ''
            : '🔒 Termine le chapitre précédent';
      });
    });
  };

  const demarrer = (h: number, c: number) => {
    histoire = h;
    courant = c;
    const chapitre = chapitres(h)[c];
    shell = new Shell(chapitre);
    sortie.replaceChildren();
    fin.hidden = true;
    const titre = chapitres(h).length > 1 ? `${HISTOIRES[h].titre} — chapitre ${chapitre.numero} : ${chapitre.titre}` : HISTOIRES[h].titre;
    afficher(`— ${titre} —`);
    afficher(shell.executer(`cat ${chapitre.accueil}`) ?? '');
    majInvite();
    majNav();
    sauver();
  };

  // Reprend une histoire à son premier chapitre pas encore terminé.
  const reprendre = (h: number) => {
    const c = chapitres(h).findIndex((ch) => !termines.includes(ch.id));
    demarrer(h, c === -1 ? chapitres(h).length - 1 : c);
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const ligne = saisie.value;
    // Un mot de passe ne s'affiche pas et ne va pas dans l'historique.
    const secret = shell.attente !== null;
    afficher(secret ? (invite.textContent ?? '') : `${invite.textContent} ${ligne}`, 'cmd');
    if (ligne.trim() && !secret) historique.push(ligne);
    position = historique.length;
    const dejaFini = shell.termine;
    const resultat = shell.executer(ligne);
    if (resultat === null) sortie.replaceChildren();
    else afficher(resultat);
    if (shell.termine && !dejaFini) {
      const id = chapitres(histoire)[courant].id;
      if (!termines.includes(id)) termines.push(id);
      sauver();
      majNav();
      fin.hidden = courant >= chapitres(histoire).length - 1;
    }
    saisie.value = '';
    majInvite();
    terminal.scrollTop = terminal.scrollHeight;
  });

  saisie.addEventListener('keydown', (e) => {
    if (shell.attente) return;
    if (e.key === 'Tab') {
      e.preventDefault();
      saisie.value = shell.completer(saisie.value);
    } else if (e.key === 'ArrowUp' && position > 0) {
      e.preventDefault();
      saisie.value = historique[--position];
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      position = Math.min(position + 1, historique.length);
      saisie.value = historique[position] ?? '';
    }
  });

  terminal.addEventListener('click', () => {
    if (!window.getSelection()?.toString()) saisie.focus();
  });
  boutonsHistoires.forEach((b, h) =>
    b.addEventListener('click', () => {
      reprendre(h);
      saisie.focus();
    }),
  );
  document.querySelectorAll<HTMLElement>('[data-chapitres]').forEach((nav) => {
    const h = Number(nav.dataset.chapitres);
    nav.querySelectorAll<HTMLButtonElement>('[data-chapitre]').forEach((b, c) =>
      b.addEventListener('click', () => {
        demarrer(h, c);
        saisie.focus();
      }),
    );
  });
  document.getElementById('suivant')!.addEventListener('click', () => {
    demarrer(histoire, courant + 1);
    saisie.focus();
  });
  document.getElementById('recommencer')!.addEventListener('click', () => {
    demarrer(histoire, courant);
    saisie.focus();
  });

  navHistoires.hidden = false;
  reprendre(histoire);
</script>
