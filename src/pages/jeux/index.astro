---
import Base from '../../layouts/Base.astro';

const jeux = [
  {
    nom: 'Terminus (MIT)',
    lien: 'https://web.mit.edu/mprat/Public/web/Terminus/Web/main.html',
    desc: "Le jeu original : une aventure où l'on se déplace avec de vraies commandes Linux (ls, cd, cat, mv…).",
    note: 'En anglais · site externe',
  },
  {
    nom: 'Terminus en français',
    lien: '/jeux/terminus/',
    desc: "Cinq histoires en français : l'Effaceur (les bases, puis les permissions et sudo), le Datacenter (journaux, tubes, processus), le Paquet perdu (ping, dig, traceroute, curl), la Machine à remonter le temps (git) et les Archives (find, tar).",
    note: '5 histoires · progression sauvegardée',
  },
];
---
<Base title="Jeux" description="Apprendre l'informatique en jouant.">
  <h1>Jeux</h1>
  <p>Apprendre en jouant, avec de vrais outils.</p>
  <div class="grid">
    {jeux.map((j) => (
      <article class="card">
        <h3><a href={j.lien}>{j.nom}</a></h3>
        <p>{j.desc}</p>
        <span class="tag">{j.note}</span>
      </article>
    ))}
  </div>
</Base>
