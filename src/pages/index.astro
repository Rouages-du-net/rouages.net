---
import Base from '../layouts/Base.astro';

const sections = [
  {
    titre: 'Comment ça marche',
    modules: [
      ["De l'Entrée à la page", 'Ce qui se passe quand on tape une adresse : DNS, TLS, BGP, câbles, serveurs.'],
      ["L'ordinateur", "Du transistor au programme, pas à pas."],
      ["L'IA", "Tokens, embeddings, attention : le vrai mécanisme."],
      ['La matérialité', 'Câbles sous-marins, datacenters, énergie, métaux.'],
      ['Le dark net', "Ce que c'est vraiment, comment Tor fonctionne, qui l'utilise et pourquoi."],
    ],
  },
  {
    titre: 'Qui décide',
    modules: [
      ['Gouvernance technique', 'IETF, W3C, ICANN, RIR : qui écrit les règles du réseau ?'],
      ['États & régulation', 'RGPD, DSA, AI Act, censure et coupures.'],
      ['Entreprises & économie', 'Opérateurs, plateformes, publicité, monopoles.'],
      ['Savoirs', "À qui appartient la connaissance ? Édition scientifique, libre accès, Sci-Hub."],
    ],
  },
  {
    titre: 'Histoires',
    modules: [
      ["L'informatique", "Une histoire mondiale, avec celles et ceux qu'on a oubliés."],
      ["Internet", "De CYCLADES et ARPANET au web et au Minitel."],
      ["L'IA", "Du perceptron aux grands modèles de langage."],
    ],
  },
  {
    titre: 'Idées reçues',
    modules: [
      ['Vrai ou faux ?', "« Le mode navigation privée me rend anonyme », « l'IA comprend ce qu'elle dit », « le dark net, c'est 90 % d'internet »… On vérifie."],
    ],
  },
  {
    titre: 'Jeux',
    modules: [
      ['Terminus', "Une aventure où l'on se déplace avec de vraies commandes Linux : l'original du MIT et notre version française.", '/jeux/'],
    ],
  },
];
---
<Base>
  <h1>Les rouages du net</h1>
  <p>
    Internet, l'informatique et l'intelligence artificielle expliqués de manière
    animée et didactique, <strong>sans masquer la vraie technologie</strong>.
  </p>
  <p class="tag">Site en construction.</p>

  {sections.map((s) => (
    <section>
      <h2>{s.titre}</h2>
      <div class="grid">
        {s.modules.map(([nom, desc, lien]) => (
          <article class="card">
            <h3>{lien ? <a href={lien}>{nom}</a> : nom}</h3>
            <p>{desc}</p>
            <span class="tag">{lien ? 'Jouable' : 'Bientôt'}</span>
          </article>
        ))}
      </div>
    </section>
  ))}
</Base>
