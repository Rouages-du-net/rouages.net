---
import Base from '../layouts/Base.astro';

const sections = [
  {
    titre: 'Comment ça marche',
    modules: [
      ["De l'Entrée à la page", 'Ce qui se passe quand on tape une adresse : DNS, TLS, BGP, câbles, serveurs.', '/modules/entree-a-la-page/'],
      ["L'ordinateur", "Du transistor au programme, pas à pas.", '/modules/ordinateur/'],
      ['Binaire, octal, hexadécimal', "Compter par paquets, faire tourner des roues, passer d'une base à l'autre.", '/modules/bases/'],
      ['Adresses IP et masques', "IPv4 en binaire, IPv6 en hexadécimal, et les masques sous leurs trois formes : /24, 255.255.255.0, 11111111…", '/modules/adresses-ip/'],
      ['Découper en sous-réseaux', "Parts égales, plan d'adressage à la bonne taille (VLSM), exercices corrigés, et IPv6.", '/modules/sous-reseaux/'],
      ["L'IA", "Ce qu'on appelle intelligence artificielle, comment une machine apprend, et ce que font vraiment les IA qui écrivent, voient, classent ou cherchent.", '/ia/'],
      ['Recommander', "Des bibliothécaires aux IA : qui choisit ce qu'on te conseille, et comment. Notes, PageRank, filtrage collaboratif.", '/recommandation/'],
      ["L'intelligence collective", "Quand un groupe en sait plus que chacun de ses membres, et quand il se trompe ensemble. Avec ou sans IA.", '/intelligence-collective/'],
      ['Penser la technique', "Expériences de pensée sur l'IA et la technique : des objectifs mal posés aux machines qui pensent. À manipuler, objections comprises.", '/penser-la-technique/'],
      ['La matérialité', 'Câbles sous-marins, datacenters, énergie, métaux.'],
      ['Le dark net', "Ce que c'est vraiment, comment Tor fonctionne, qui l'utilise et pourquoi.", '/modules/dark-net/'],
    ],
  },
  {
    titre: 'Qui décide',
    modules: [
      ['Gouvernance technique', 'IETF, W3C, ICANN, RIR : qui écrit les règles du réseau ?'],
      ['États & régulation', 'RGPD, DSA, AI Act, censure et coupures.'],
      ['Entreprises & économie', 'Opérateurs, plateformes, publicité, monopoles.'],
      ['Savoirs', "À qui appartient la connaissance ? Édition scientifique, libre accès, Sci-Hub."],
    ],
  },
  {
    titre: 'Histoires',
    modules: [
      ["L'informatique", "Une histoire mondiale, avec celles et ceux qu'on a oubliés.", '/modules/histoire-informatique/'],
      ["Internet", "De CYCLADES et ARPANET au web et au Minitel.", '/modules/histoire-internet/'],
      ["L'IA", "Des automates d'Alexandrie à ChatGPT, de Moscou à Johannesburg.", '/modules/histoire-ia/'],
    ],
  },
  {
    titre: 'Idées reçues',
    modules: [
      ['Vrai ou faux ?', "« Le dark net, c'est 90 % d'internet », « l'IA comprend ce qu'elle dit », « je n'ai rien à cacher »… Dix idées reçues vérifiées, sources à l'appui.", '/vrai-ou-faux/'],
    ],
  },
  {
    titre: 'Jeux',
    modules: [
      ['Quêtes de Sysadmin', "Cinq histoires pour apprendre la ligne de commande et l'administration système Linux, directement dans le navigateur.", '/jeux/quetes-de-sysadmin/'],
      ['Jeux pour apprendre', "Près de 70 jeux classés par thème (ligne de commande, programmation, réseaux, sécurité, IA, désinformation…), avec ce qu'il faut savoir avant de jouer.", '/jeux/'],
    ],
  },
];
---
<Base>
  <h1>Les rouages du net</h1>
  <p>
    Internet, l'informatique et l'intelligence artificielle expliqués de manière
    animée et didactique, <strong>sans masquer la vraie technologie</strong>.
  </p>
  <p class="tag" data-pagefind-ignore>Site en construction.</p>

  {sections.map((s) => (
    <section>
      <h2>{s.titre}</h2>
      <div class="grid">
        {s.modules.map(([nom, desc, lien]) => (
          <article class="card">
            <h3>{lien ? <a href={lien}>{nom}</a> : nom}</h3>
            <p>{desc}</p>
            <span class="tag">{lien ? 'Disponible' : 'Bientôt'}</span>
          </article>
        ))}
      </div>
    </section>
  ))}
</Base>
