---
import Base from '../layouts/Base.astro';
import Cartes from '../components/Cartes.astro';
import Accueil from '../components/Accueil.astro';

type Module = [string, string, string?];
interface Groupe { titre: string; intro?: string; modules: Module[] }
interface Section { titre: string; modules?: Module[]; groupes?: Groupe[] }

const ancre = (t: string) => 'g-' + t.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().replace(/[^a-z0-9]+/g, '-');

const sections: Section[] = [
  {
    titre: 'Comment ça marche',
    groupes: [
      {
        titre: 'Les bases techniques',
        intro: 'Les notions à maîtriser avant le reste, avec des exercices pour les cours.',
        modules: [
          ["L'ordinateur", "Du transistor au programme, pas à pas.", '/modules/ordinateur/'],
          ['Binaire, octal, hexadécimal', "Compter par paquets, faire tourner des roues, passer d'une base à l'autre.", '/modules/bases/'],
          ['Adresses IP et masques', "IPv4 en binaire, IPv6 en hexadécimal, et les masques sous leurs trois formes : /24, 255.255.255.0, 11111111…", '/modules/adresses-ip/'],
          ['Découper en sous-réseaux', "Parts égales, plan d'adressage à la bonne taille (VLSM), exercices corrigés, et IPv6.", '/modules/sous-reseaux/'],
          ['Client et serveur', "Qui demande, qui répond : ports, URL et fichiers, HTTP et HTTPS, FTP, FTPS et SFTP.", '/modules/client-serveur/'],
          ['Linux : fichiers, droits, SSH', "L'arborescence et ses dossiers, chemins, comptes et groupes, droits rwx (ls -l, 750, chmod), root et sudo, SSH et rebonds par un bastion.", '/modules/linux/'],
        ],
      },
      {
        titre: 'Internet au quotidien',
        modules: [
          ["De l'Entrée à la page", 'Ce qui se passe quand on tape une adresse : DNS, TLS, BGP, câbles, serveurs.', '/modules/entree-a-la-page/'],
          ['Se protéger', "Mots de passe et phrases de passe, double authentification, arnaques, chiffrement d'al-Kindi à Signal, mises à jour et sauvegardes.", '/modules/se-proteger/'],
          ['La matérialité', 'Câbles sous-marins, centres de données, électricité, eau, métaux, déchets : ce que pèse vraiment le numérique.', '/modules/materialite/'],
          ['Le dark net', "Ce que c'est vraiment, comment Tor fonctionne, qui l'utilise et pourquoi.", '/modules/dark-net/'],
        ],
      },
      {
        titre: 'Intelligence artificielle',
        modules: [
          ["L'IA", "Ce qu'on appelle intelligence artificielle, comment une machine apprend, et ce que font vraiment les IA qui écrivent, voient, classent ou cherchent.", '/ia/'],
          ['Recommander', "Des bibliothécaires aux IA : qui choisit ce qu'on te conseille, et comment. Notes, PageRank, filtrage collaboratif.", '/recommandation/'],
          ["L'intelligence collective", "Quand un groupe en sait plus que chacun de ses membres, et quand il se trompe ensemble. Avec ou sans IA.", '/intelligence-collective/'],
          ['Penser la technique', "Expériences de pensée sur l'IA et la technique : des objectifs mal posés aux machines qui pensent. À manipuler, objections comprises.", '/penser-la-technique/'],
        ],
      },
    ],
  },
  {
    titre: 'Qui décide',
    modules: [
      ['Les institutions', "Fiches de l'IETF, l'ICANN, du W3C, des registres, de l'UIT, de la CNIL, de l'Arcom… et carte de qui finance, nomme ou contrôle qui.", '/institutions/'],
      ['Gouvernance technique', 'IETF, W3C, ICANN, registres régionaux, serveurs racine, ONU : qui écrit les règles du réseau, et comment ?', '/modules/gouvernance-technique/'],
      ['États et régulation', 'RGPD, DSA, AI Act, neutralité du net, blocages et coupures d’internet : qui fait les lois du numérique ?', '/modules/etats-regulation/'],
      ['Entreprises et économie', "Qui paie les câbles, le cloud, une pub vendue aux enchères en 120 ms, d'où vient l'argent de Google, Meta et Amazon, monopoles et régulateurs.", '/modules/economie/'],
      ['Savoirs', "À qui appartient la connaissance ? Qui paie la recherche et sa lecture, l'accès ouvert, le savoir vu du Sud, Sci-Hub, les bibliothèques de l'ombre et l'IA.", '/modules/savoirs/'],
    ],
  },
  {
    titre: 'Histoires',
    modules: [
      ["L'informatique", "Une histoire mondiale, avec celles et ceux qu'on a oubliés.", '/modules/histoire-informatique/'],
      ["Internet", "De CYCLADES et ARPANET au web et au Minitel.", '/modules/histoire-internet/'],
      ["L'IA", "Des automates d'Alexandrie à ChatGPT, de Moscou à Johannesburg.", '/modules/histoire-ia/'],
    ],
  },
  {
    titre: 'Idées reçues',
    modules: [
      ['Vrai ou faux ?', "« Le dark net, c'est 90 % d'internet », « l'IA comprend ce qu'elle dit », « la navigation privée rend anonyme »… Seize idées reçues vérifiées, sources à l'appui.", '/vrai-ou-faux/'],
    ],
  },
  {
    titre: 'Jeux',
    modules: [
      ['Quêtes de Sysadmin', "Cinq histoires pour apprendre la ligne de commande et l'administration système Linux, directement dans le navigateur.", '/jeux/quetes-de-sysadmin/'],
      ['Jeux pour apprendre', "Près de 70 jeux classés par thème (ligne de commande, programmation, réseaux, sécurité, IA, désinformation…), avec ce qu'il faut savoir avant de jouer.", '/jeux/'],
    ],
  },
];
---
<Base>
  <Accueil />

  {sections.map((s) => (
    <section>
      <h2 class="titre-section"><span class="kicker" aria-hidden="true">{'>_'}</span> {s.titre}</h2>
      {s.modules && <Cartes modules={s.modules} niveau={3} />}
      {s.groupes?.map((g) => (
        <section class="groupe" aria-labelledby={ancre(g.titre)}>
          <h3 id={ancre(g.titre)}>{g.titre}</h3>
          {g.intro && <p class="intro-groupe">{g.intro}</p>}
          <Cartes modules={g.modules} niveau={4} />
        </section>
      ))}
    </section>
  ))}
</Base>

<style>
  .titre-section { margin-top: 3rem; font-size: 1.9rem; }
  .kicker { font-family: var(--police-pixel); font-weight: 400; font-size: 0.6em; color: var(--accent-2); vertical-align: 0.2em; }
  .groupe { margin-top: 1.5rem; }
  .groupe h3 { margin-bottom: 0.4rem; }
  .intro-groupe { margin: 0 0 0.8rem; color: var(--muted); max-width: var(--mesure); }
</style>
