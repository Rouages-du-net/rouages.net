</Base>

<style>
  .chapo { font-size: 1.15rem; max-width: var(--mesure); }
  section { max-width: var(--mesure); margin-top: 2.2rem; }
  dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0.35rem 1rem; margin: 0; }
  dt { font-weight: 700; }
  dd { margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 30rem) { dl { grid-template-columns: 1fr; } dd { margin-bottom: 0.5rem; } }
  .maj { color: var(--muted); }
</style>
