      { auteur: 'Assemblée générale des Nations unies', titre: 'Résolution 78/241, Systèmes d’armes létaux autonomes', url: 'https://digitallibrary.un.org/record/4033027', type: 'primaire', annee: 2023 },
      { auteur: 'UN Project', titre: 'Vote sur la résolution A/RES/80/57 (1er décembre 2025)', url: 'https://un-project.org/votes/resolution/A-RES-80-57/', type: 'site', annee: 2025, langue: 'en' },
      { auteur: 'Reuters (via Stock Analysis)', titre: 'U.S. probes whether Waymo’s school bus fix failed, covering 2,895 robotaxis', url: 'https://stockanalysis.com/news/waymo-school-bus-recall-probe/', type: 'presse', annee: 2026, langue: 'en' },
      { auteur: 'KXAN', titre: 'NHTSA probing Waymo software recall after bus violations', url: 'https://www.kxan.com/investigations/nhtsa-probing-waymo-software-recall-after-bus-violations/amp/', type: 'presse', annee: 2026, langue: 'en' },
      { auteur: 'ONU', titre: '7ᵉ conférence d’examen de la CCW, 11ᵉ séance (transcription, 20 novembre 2026)', url: 'https://transcripts.un.org/en/asset/k1g/k1g52399ip', type: 'primaire', annee: 2026, langue: 'en' },
      { auteur: 'AP (via Daily News Egypt)', titre: 'UN killer robots talks put off binding AI weapons rules until 2028', url: 'https://africa.dailynewsegypt.com/un-killer-robots-talks-2028/', type: 'presse', annee: 2026, langue: 'en' },
      { auteur: 'MENAFN', titre: 'UN Notes Progress on AI Weapons Rules as Treaty Efforts Stall (citations de l’ONU et du CICR)', url: 'https://menafn.com/1112002542/UN-Notes-Progress-on-AI-Weapons-Rules-as-Treaty-Efforts-Stall', type: 'presse', annee: 2026, langue: 'en' },
    ]}
  />
  </section>
</Base>

<style>
  .chapo { font-size: 1.15rem; max-width: var(--mesure); }
  .reglages { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin: 2rem 0 2.5rem; }
  .reglages .tag { margin: 0; }
  .final { padding: 3.5rem 0 2rem; border-top: 1px solid var(--border); scroll-margin-top: 4.5rem; }
  .final > p, .questions { max-width: var(--mesure); }
  .questions li { margin-bottom: 0.5rem; }
</style>
