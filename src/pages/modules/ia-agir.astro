      { auteur: 'IEEE Milestones', titre: 'Shakey: The World’s First Mobile, Intelligent Robot, 1972', url: 'https://ieeemilestones.ethw.org/Milestones:Shakey:_The_World%E2%80%99s_First_Mobile,_Intelligent_Robot,_1972', type: 'site', langue: 'en' },
