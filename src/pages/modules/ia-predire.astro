      { auteur: 'K. Lum, W. Isaac', titre: 'To Predict and Serve? (Significance 13-5)', url: 'https://doi.org/10.1111/j.1740-9713.2016.00960.x', type: 'recherche', annee: 2016, langue: 'en' },
