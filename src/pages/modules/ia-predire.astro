      { auteur: 'D. Ensign et al.', titre: 'Runaway Feedback Loops in Predictive Policing (PMLR 81)', url: 'https://proceedings.mlr.press/v81/ensign18a.html', type: 'recherche', annee: 2018, langue: 'en' },
      { auteur: 'D. Mehrotra, S. Mattu, A. Gilbertson, A. Sankin (The Markup)', titre: 'How We Determined Crime Prediction Software Disproportionately Targeted Low-Income, Black, and Latino Neighborhoods', url: 'https://themarkup.org/show-your-work/2021/12/02/how-we-determined-crime-prediction-software-disproportionately-targeted-low-income-black-and-latino-neighborhoods', type: 'presse', annee: 2021, langue: 'en' },
      { auteur: 'Union européenne', titre: 'Règlement (UE) 2024/1689 sur l’intelligence artificielle, article 5', url: 'https://eur-lex.europa.eu/legal-content/FR/TXT/HTML/?uri=OJ:L_202401689', type: 'primaire', annee: 2024 },
    ]}
  />
  </section>
</Base>

<style>
  .chapo { font-size: 1.15rem; max-width: var(--mesure); }
  .reglages { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin: 2rem 0 2.5rem; }
  .reglages .tag { margin: 0; }
  .final { padding: 3.5rem 0 2rem; border-top: 1px solid var(--border); scroll-margin-top: 4.5rem; }
  .final > p, .questions { max-width: var(--mesure); }
  .questions li { margin-bottom: 0.5rem; }
</style>
