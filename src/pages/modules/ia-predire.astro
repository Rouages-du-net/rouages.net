      { auteur: 'J. G. Charney, R. Fjörtoft, J. von Neumann', titre: 'Numerical Integration of the Barotropic Vorticity Equation (Tellus 2-4), résumé', url: 'https://doi.org/10.3402/tellusa.v2i4.8607', type: 'primaire', annee: 1950, langue: 'en' },
      { auteur: 'C. Yang', titre: 'The First Compute Arms Race: the Early History of Numerical Weather Prediction', url: 'https://arxiv.org/abs/2506.21816', type: 'recherche', annee: 2025, langue: 'en' },
