      { auteur: 'F. H. Messerli', titre: 'Chocolate Consumption, Cognitive Function, and Nobel Laureates (NEJM 367), notice', url: 'https://doi.org/10.1056/NEJMon1211064', type: 'recherche', annee: 2012, langue: 'en' },
