---
import Base from '../../layouts/Base.astro';
import Etape from '../../components/Etape.astro';
import Terme from '../../components/Terme.astro';
import SelecteurNiveau from '../../components/SelecteurNiveau.astro';
import Sources from '../../components/Sources.astro';
import Frise from '../../components/Frise.astro';
import ModeLecture from '../../components/ModeLecture.astro';
import MotSuivant from '../../components/animations/ia/MotSuivant.astro';
import Tokeniseur from '../../components/animations/ia/Tokeniseur.astro';
import Plongements from '../../components/animations/ia/Plongements.astro';
import Neurone from '../../components/animations/ia/Neurone.astro';
import Descente from '../../components/animations/ia/Descente.astro';
import Attention from '../../components/animations/ia/Attention.astro';
import Temperature from '../../components/animations/ia/Temperature.astro';
import Fabrication from '../../components/animations/ia/Fabrication.astro';

// Chiffres sourcés : voir docs/sources/ia-mecanismes.md.
const maillons = [
  {
    icone: '📚',
    titre: 'Rassembler des textes',
    texte: "On collecte d'immenses quantités de textes : pages web, livres, code, articles, puis on les nettoie. GPT-2 (2019) a appris sur environ 40 Go de texte tiré de 8 millions de pages web ; pour Llama 3 (2024), Meta annonce plus de 15 000 milliards de tokens, dont à peine plus de 5 % dans une autre langue que l'anglais. La liste exacte des textes n'est en général pas publiée.",
    qui: 'Des robots d’indexation, des équipes d’ingénierie… et les autrices et auteurs de tous ces textes, rarement consulté·es.',
  },
  {
    icone: '🔥',
    titre: 'Pré-entraîner',
    texte: "Le modèle lit ces textes et s'entraîne à deviner le token suivant, des milliers de milliards de fois. À chaque erreur, la descente de gradient ajuste un peu ses paramètres : 1,5 milliard pour GPT-2 (2019), 175 milliards pour GPT-3 (2020), entraîné sur 300 milliards de tokens.",
    qui: 'Des milliers de processeurs graphiques qui tournent pendant des semaines, dans des centres de données qui consomment de l’électricité et de l’eau.',
  },
  {
    icone: '🧑‍🏫',
    titre: 'Ajuster avec des humains',
    texte: "Un modèle qui ne fait que prolonger des textes n'est pas un assistant. Des personnes écrivent des exemples de bonnes réponses et classent les réponses du modèle ; on l'entraîne encore pour qu'il préfère celles qui sont jugées meilleures. Pour InstructGPT (2022), ces préférences étaient celles d'une quarantaine d'annotatrices et d'annotateurs.",
    qui: 'Des annotatrices et annotateurs, souvent sous-traité·es, parfois dans des pays où ce travail est très mal payé.',
  },
  {
    icone: '🛡️',
    titre: 'Filtrer',
    texte: "On ajoute des garde-fous : refuser certaines demandes, repérer les contenus violents ou illégaux. Pour apprendre à les reconnaître, des humains doivent d'abord les lire et les étiqueter.",
    qui: 'Des modératrices et modérateurs, exposé·es à des contenus parfois traumatisants.',
  },
  {
    icone: '💬',
    titre: 'Répondre',
    texte: "Quand tu poses une question, ton texte est découpé en tokens, et le modèle calcule le token suivant, puis le suivant… Chaque token demande un calcul qui fait intervenir tous ses paramètres.",
    qui: 'Encore des processeurs graphiques, dans un centre de données, pour chacune des questions posées dans le monde.',
  },
];

const etapes = [
  { ancre: 'prediction', court: 'Le mot suivant' },
  { ancre: 'tokens', court: 'Les tokens' },
  { ancre: 'plongements', court: 'Les plongements' },
  { ancre: 'neurone', court: 'Le neurone' },
  { ancre: 'apprentissage', court: 'Apprendre' },
  { ancre: 'attention', court: "L'attention" },
  { ancre: 'generation', court: 'Écrire' },
  { ancre: 'fabrication', court: 'Les coulisses' },
  { ancre: 'bilan', court: 'Ton assistant', pastille: '✓' },
];
---
<Base
  title="Les IA qui écrivent"
  description="Les grands modèles de langage, démontés pièce par pièce : prédire le mot suivant, tokens, plongements, neurones, attention, température, et les humains derrière la machine."
>
  <p class="tag">Comment ça marche · L'IA · module en construction</p>
  <h1>Les IA qui écrivent</h1>
  <p class="chapo seulement-debut">
    Les assistants comme ChatGPT, Gemini ou Le Chat semblent penser. En réalité, ils font
    une seule chose, très bien : deviner la suite d'un texte. Démontons la machine, pièce par
    pièce, avec un vrai petit modèle qui tourne dans ton navigateur.
  </p>
  <aside class="autres-ia seulement-debut" aria-labelledby="titre-autres-ia">
    <p id="titre-autres-ia"><strong>L'IA ne se limite pas aux chatbots.</strong></p>
    <p>
      Ce module parle des <em>modèles de langage</em>, les IA qui écrivent. D'autres IA
      reconnaissent des visages, trient les courriels, calculent ton itinéraire, jouent aux
      échecs, conduisent des voitures ou choisissent les vidéos qu'on te propose ; certaines
      n'apprennent même pas, elles suivent des règles écrites à la main. Ces autres familles auront leurs propres
      modules.
    </p>
  </aside>

  <div class="reglages">
    <SelecteurNiveau />
    <ModeLecture />
    <p class="tag">Choisis ton niveau et ta façon de lire : tu peux en changer à tout moment.</p>
  </div>

  <Frise etapes={etapes} />

  <!-- Étape 0 -->
  <Etape numero={0} titre="Deviner le mot suivant" ancre="prediction">
    <MotSuivant slot="animation" />
    <p slot="decouverte">
      Un assistant d'IA n'a pas de réponse toute faite. Il écrit sa réponse un morceau après
      l'autre, en devinant à chaque fois ce qui vient le plus probablement après. Le petit
      modèle ci-dessus fait exactement cela, après avoir lu seulement quelques dizaines de
      phrases.
    </p>
    <p slot="curieux">
      C'est un <Terme id="modele-de-langage">modèle de langage</Terme> : pour un début de texte,
      il donne une probabilité à chaque suite possible. Le nôtre se contente de compter quel mot
      suit quels deux mots dans ses lectures. Les grands modèles, eux, calculent ces
      probabilités avec des milliards de nombres réglés pendant l'entraînement, et tiennent
      compte de tout ce qui précède, pas seulement des deux derniers mots.
    </p>
    <p slot="ingenieur">
      Notre modèle est un « n-gramme » (ici n = 3 : deux mots de contexte, avec repli sur un
      seul mot quand le contexte n'a jamais été vu). Un grand modèle de langage calcule, à
      partir de toute la séquence, une distribution de probabilités sur son vocabulaire de
      tokens, en tire un, l'ajoute à la séquence, et recommence : on dit qu'il est
      autorégressif.
    </p>
    <div slot="histoire">
      <p>
        Le 23 janvier 1913, à Saint-Pétersbourg, le mathématicien <strong>Andreï Markov</strong>
        recopie à la main les 20 000 premières lettres d'<em>Eugène Onéguine</em>, le roman de
        Pouchkine, et compte voyelles et consonnes : il montre qu'une lettre dépend de celle qui
        la précède. Ce sont les « chaînes de Markov », lointaines ancêtres des modèles de
        langage. En 1948, aux États-Unis, Claude Shannon fabrique du « faux anglais » en tirant
        des lettres, puis des mots, selon ce qui les suit d'habitude : plus le contexte est
        long, plus le texte sonne anglais… sans rien vouloir dire.
      </p>
    </div>
    <p slot="verifie">Tape un début de phrase avec un mot que le modèle n'a jamais lu (« le dragon ») : il ne sait plus rien prédire. Il ne connaît que ce qu'il a lu.</p>
    <p slot="mythes">
      <strong>« L'IA comprend ce qu'elle dit. »</strong> Elle calcule ce qui vient le plus
      probablement après. Le résultat peut être juste, utile, impressionnant… ou faux avec
      aplomb : rien dans ce calcul ne vérifie que c'est vrai. Le piège est ancien : en 1966,
      au MIT, Joseph Weizenbaum publie ELIZA, un programme qui se contente de reformuler les
      phrases tapées. Il note que « certaines personnes ont eu beaucoup de mal à être
      convaincues qu'ELIZA n'est pas humain ». On appelle aujourd'hui « effet ELIZA » cette
      tendance à prêter de la compréhension à une machine qui produit des phrases plausibles.
    </p>
  </Etape>

  <!-- Étape 1 -->
  <Etape numero={1} titre="Découper le texte en tokens" ancre="tokens">
    <Tokeniseur slot="animation" />
    <p slot="decouverte">
      Un ordinateur ne calcule qu'avec des nombres. Avant tout, le texte est donc découpé en
      petits morceaux, les <Terme id="token">tokens</Terme>, et chaque morceau reçoit un
      numéro. Un token, c'est souvent un mot courant, ou un bout de mot rare.
    </p>
    <p slot="curieux">
      Le découpage est appris à l'avance : on part des lettres, et l'on fusionne les paires
      les plus fréquentes, jusqu'à obtenir un vocabulaire de quelques dizaines à quelques
      centaines de milliers de tokens (50 257 pour GPT-2, environ 128 000 pour Llama 3). Les
      mots fréquents tiennent en un token ; les mots rares, en plusieurs.
    </p>
    <p slot="ingenieur">
      L'algorithme s'appelle BPE (<em>byte pair encoding</em>). Les vrais tokeniseurs partent
      des octets du texte encodé en UTF-8 plutôt que des lettres : ainsi, aucun caractère n'est
      jamais inconnu. Le modèle ne voit jamais les lettres, seulement des numéros de tokens.
    </p>
    <p slot="histoire">
      L'algorithme BPE est d'abord une méthode de compression de données, publiée par Philip
      Gage en 1994. En 2016, Rico Sennrich, Barry Haddow et Alexandra Birch l'adaptent au
      découpage des mots pour la traduction automatique.
    </p>
    <p slot="decide">
      Chaque entreprise construit le tokeniseur de ses modèles, surtout à partir de textes en
      anglais. Résultat, mesuré en 2023 : un même texte demande environ 1,6 fois plus de tokens
      en français qu'en anglais avec le tokeniseur de ChatGPT et GPT-4, et jusqu'à 15 fois plus
      pour certaines langues. Plus de tokens, c'est plus de calcul, et souvent plus cher.
    </p>
    <p slot="verifie">Tape « anticonstitutionnellement » : notre petit tokeniseur le découpe en nombreux morceaux, parce qu'il ne l'a jamais lu.</p>
  </Etape>

  <!-- Étape 2 -->
  <Etape numero={2} titre="Les mots deviennent des points" ancre="plongements">
    <Plongements slot="animation" />
    <p slot="decouverte">
      Chaque token est ensuite transformé en une liste de nombres, comme des coordonnées sur
      une carte. Les mots de sens proche se retrouvent près les uns des autres.
    </p>
    <p slot="curieux">
      Ces coordonnées s'appellent des <Terme id="plongement">plongements</Terme>
      (<em>embeddings</em>). Personne ne les choisit à la main : elles sont apprises en
      observant quels mots apparaissent dans les mêmes contextes. Mais une carte apprise sur
      des textes humains reproduit aussi leurs stéréotypes.
    </p>
    <p slot="ingenieur">
      Un plongement est un vecteur de quelques centaines à quelques milliers de dimensions. La
      proximité se mesure souvent par le cosinus de l'angle entre deux vecteurs. Les célèbres
      analogies (« roi − homme + femme ≈ reine ») marchent bien pour certaines relations
      (pays et capitales, conjugaisons), beaucoup moins pour d'autres. Et les programmes
      d'évaluation excluent d'office les mots de la question : sans cette règle, le point le
      plus proche est le plus souvent… « roi » lui-même.
    </p>
    <div slot="histoire">
      <p>
        En 2013, chez Google, Tomas Mikolov et ses collègues publient word2vec, qui apprend des
        plongements à partir de milliards de mots, et montrent l'exemple « king − man + woman ≈
        queen ». En 2016 et 2017, plusieurs équipes mesurent les stéréotypes que ces
        plongements ont appris : l'une titre « Man is to Computer Programmer as Woman is to
        Homemaker? ». Les corriger les atténue, sans les supprimer.
      </p>
      <p>
        Bien avant, à Cambridge, la linguiste et philosophe <strong>Margaret Masterman</strong>
        fonde le Cambridge Language Research Unit, l'un des tout premiers centres de
        linguistique informatique. Son équipe représente le sens par des concepts reliés entre
        eux, les « réseaux sémantiques », pour la traduction automatique. Karen Spärck Jones,
        qui y fait ses débuts, invente en 1972 une façon de pondérer les mots selon leur rareté,
        toujours au cœur des moteurs de recherche.
      </p>
    </div>
    <p slot="verifie">Clique sur un mot de la carte pour voir ses voisins, puis essaie « chat − chien + chienne ».</p>
  </Etape>

  <!-- Étape 3 -->
  <Etape numero={3} titre="Un neurone artificiel" ancre="neurone">
    <Neurone slot="animation" />
    <p slot="decouverte">
      Les calculs du modèle sont faits par des milliards de <Terme id="neurone-artificiel">neurones
      artificiels</Terme>. Un neurone, c'est une petite formule : il multiplie chaque entrée par
      un « poids », additionne, et décide.
    </p>
    <p slot="curieux">
      Les poids sont les <Terme id="parametre">paramètres</Terme> du modèle. Apprendre, c'est
      trouver de bons poids. Un neurone seul ne sait tracer qu'une ligne droite (il échoue,
      par exemple, sur le « ou exclusif ») ; en empilant des couches de neurones, on obtient
      des frontières aussi compliquées qu'on veut.
    </p>
    <p slot="ingenieur">
      Sortie = f(w₁x₁ + w₂x₂ + b). Le perceptron utilise un seuil ; les réseaux modernes, des
      fonctions continues, pour pouvoir calculer des pentes (étape suivante). Un grand modèle de
      langage, ce sont surtout d'immenses multiplications de matrices.
    </p>
    <div slot="histoire">
      <p>
        En 1957-1958, aux États-Unis, Frank Rosenblatt invente le perceptron, l'un des premiers
        réseaux de neurones capables d'apprendre à partir d'exemples (article de 1958 dans la
        <em>Psychological Review</em>). Au Japon,
        <strong>Kunihiko Fukushima</strong> conçoit en 1979-1980 le néocognitron, inspiré du
        cortex visuel, précurseur des réseaux qui reconnaissent les images.
      </p>
    </div>
    <p slot="mythes">
      <strong>« Un réseau de neurones fonctionne comme un cerveau. »</strong> Le neurone
      artificiel est une formule très simplifiée, à peine inspirée des neurones biologiques.
    </p>
  </Etape>

  <!-- Étape 4 -->
  <Etape numero={4} titre="Apprendre en se trompant" ancre="apprentissage">
    <Descente slot="animation" />
    <p slot="decouverte">
      Au début, les poids sont pris au hasard et le modèle dit n'importe quoi. On lui montre
      un texte, il devine le mot suivant, on mesure son erreur, et l'on corrige un peu tous
      ses poids dans le bon sens. Puis on recommence, des milliards de fois.
    </p>
    <p slot="curieux">
      Pour savoir dans quel sens corriger, on calcule la pente de l'erreur : c'est la
      <Terme id="descente-de-gradient">descente de gradient</Terme>. La taille de chaque pas
      compte : trop petite, l'apprentissage traîne ; trop grande, il s'emballe.
    </p>
    <p slot="ingenieur">
      L'erreur est mesurée par l'entropie croisée entre la prédiction et le vrai token suivant.
      La rétropropagation calcule la pente par rapport à chacun des milliards de paramètres,
      couche par couche, de la sortie vers l'entrée. On ajuste par petits paquets d'exemples :
      c'est la descente de gradient stochastique.
    </p>
    <div slot="histoire">
      <p>
        Au Japon, <strong>Shun-ichi Amari</strong> décrit dès 1967 l'apprentissage de réseaux
        de neurones par gradient stochastique. La rétropropagation a été découverte plusieurs
        fois : on la trouve en 1970 dans le mémoire de master du Finlandais Seppo Linnainmaa
        (pour calculer des erreurs d'arrondi, sans lien avec les neurones) ; l'Américain Paul
        Werbos l'applique aux réseaux de neurones ; David Rumelhart, Geoffrey Hinton et Ronald
        Williams la rendent célèbre en 1986, dans la revue <em>Nature</em>. À Kyiv, en Ukraine
        soviétique, <strong>Oleksiï Ivakhnenko</strong> et Valentin Lapa entraînent dès le milieu
        des années 1960 des réseaux à plusieurs couches (la méthode GMDH) ; en 1971, Ivakhnenko
        en décrit un à 8 couches. Le chercheur Jürgen Schmidhuber y voit « peut-être » les
        premiers systèmes d'apprentissage profond.
      </p>
    </div>
  </Etape>

  <!-- Étape 5 -->
  <Etape numero={5} titre="L'attention" ancre="attention">
    <Attention slot="animation" />
    <p slot="decouverte">
      Pour bien deviner la suite, il faut savoir de quoi parle chaque mot. « Il », c'est qui ?
      L'<Terme id="attention">attention</Terme> permet à chaque mot de regarder les autres mots
      de la phrase et d'y prendre ce qui l'aide à se comprendre.
    </p>
    <p slot="curieux">
      Chaque mot pose une question (sa « requête ») et chaque mot affiche une étiquette (sa
      « clé ») : plus elles se ressemblent, plus l'attention est forte. Le mot récupère alors un
      mélange des informations des mots qu'il regarde. C'est la pièce maîtresse des
      <Terme id="transformeur">transformeurs</Terme>, l'architecture de tous les grands modèles
      de langage actuels.
    </p>
    <p slot="ingenieur">
      Attention(Q, K, V) = softmax(QKᵀ / √dₖ) V : chaque token produit une requête Q, une clé K
      et une valeur V ; on compare sa requête aux clés de tous les tokens, le softmax donne des
      poids qui somment à 1, et l'on fait la moyenne des valeurs avec ces poids. Chaque couche
      contient plusieurs « têtes » en parallèle (8 dans l'article de 2017), chacune pouvant
      repérer un type de relation différent, et un modèle empile des dizaines de couches. Dans un modèle
      qui génère du texte, chaque token ne peut regarder que les tokens qui le précèdent.
    </p>
    <div slot="histoire">
      <p>
        En 2014, Dzmitry Bahdanau, Kyunghyun Cho et Yoshua Bengio inventent l'attention pour la
        traduction automatique : pour produire chaque mot traduit, le réseau « cherche » les
        mots utiles dans la phrase de départ. En 2017, huit chercheuses et chercheurs, pour
        la plupart chez Google, Ashish Vaswani, Noam Shazeer, <strong>Niki Parmar</strong>, Jakob Uszkoreit,
        Llion Jones, Aidan Gomez, Łukasz Kaiser et Illia Polosukhin, publient « Attention Is
        All You Need » : le transformeur, qui ne repose que sur l'attention. Les modèles GPT
        grandissent ensuite très vite : 1,5 milliard de paramètres pour GPT-2 (2019), 175
        milliards pour GPT-3 (2020).
      </p>
    </div>
    <p slot="verifie">Change le dernier mot de la phrase : « fatigué » ou « étroit ». Le même « il » ne regarde plus le même mot.</p>
  </Etape>

  <!-- Étape 6 -->
  <Etape numero={6} titre="Écrire : un peu de hasard" ancre="generation">
    <Temperature slot="animation" />
    <p slot="decouverte">
      Le modèle ne choisit pas toujours le mot le plus probable : il tire au sort, en
      favorisant les mots probables. C'est pour cela qu'une même question n'obtient pas deux
      fois exactement la même réponse.
    </p>
    <p slot="curieux">
      La <Terme id="temperature">température</Terme> règle la dose de hasard. Basse : le
      modèle est prévisible et se répète. Haute : il est plus inventif, mais déraille plus
      facilement.
    </p>
    <p slot="ingenieur">
      On divise les scores (les « logits ») par la température T avant le softmax :
      p = softmax(z / T). T → 0 revient à toujours prendre le plus probable. D'autres réglages
      limitent le tirage aux k mots les plus probables (top-k) ou à ceux qui totalisent une
      probabilité p (top-p).
    </p>
    <p slot="mythes">
      <strong>« Quand l'IA invente, c'est un bug qu'on va bientôt corriger. »</strong> Le modèle
      produit toujours le texte le plus vraisemblable, pas le plus vrai. Une réponse inventée
      mais plausible, ce qu'on appelle une <Terme id="hallucination">hallucination</Terme>, est
      une conséquence directe de ce fonctionnement. On peut la rendre plus rare, pas la
      supprimer à coup sûr.
    </p>
    <div slot="histoire">
      <p>
        Le mot « hallucination » est une métaphore discutée : le modèle ne perçoit rien. En
        2025, des chercheurs d'OpenAI et de Georgia Tech proposent une explication : un modèle
        qui imite des textes se trompe forcément sur les faits rares, vus une seule fois ; et
        les tests habituels, qui notent zéro un « je ne sais pas » comme une erreur, l'incitent
        à deviner plutôt qu'à avouer son incertitude. C'est une analyse parmi d'autres : la
        question reste ouverte.
      </p>
      <p>
        Faire écrire des textes à une machine est un vieux champ de recherche :
        <strong>Kathleen McKeown</strong>, professeure à l'université Columbia, est une
        pionnière de la génération automatique de texte et du résumé automatique.
      </p>
    </div>
  </Etape>

  <!-- Étape 7 -->
  <Etape numero={7} titre="Les coulisses : des humains et des machines" ancre="fabrication">
    <Fabrication slot="animation" maillons={maillons} />
    <p slot="decouverte">
      Derrière chaque réponse, il y a des textes écrits par des millions de personnes, des
      centres de données pleins de processeurs, et des travailleuses et travailleurs qui
      annotent et modèrent, souvent loin des projecteurs.
    </p>
    <p slot="curieux">
      Après le pré-entraînement, le modèle est ajusté avec l'aide d'humains, qui montrent de
      bonnes réponses et classent celles du modèle. C'est ce qui le transforme en assistant qui
      répond aux questions, plutôt qu'en machine qui prolonge n'importe quel texte.
    </p>
    <p slot="ingenieur">
      Cette étape s'appelle souvent RLHF (<em>reinforcement learning from human feedback</em>) :
      un second modèle, le « modèle de récompense », apprend à prédire les préférences
      humaines, et sert à affiner le premier par apprentissage par renforcement. Avec
      InstructGPT (2022), les réponses d'un modèle 100 fois plus petit que GPT-3 ont été
      préférées à celles de GPT-3. Mais ces préférences sont celles d'un petit groupe de
      personnes, pas des « valeurs humaines » universelles.
    </p>
    <div slot="histoire">
      <p>
        En 2009, <strong>Fei-Fei Li</strong> et son équipe publient ImageNet, une base d'images
        annotées à la main par des milliers de travailleurs et travailleuses en ligne. En 2018,
        <strong>Joy Buolamwini</strong> et <strong>Timnit Gebru</strong> montrent que des
        systèmes commerciaux d'analyse de visages se trompent bien plus souvent pour les femmes
        à peau foncée que pour les hommes à peau claire. Dès 2013, <strong>Latanya
        Sweeney</strong> avait montré qu'une recherche Google sur un prénom associé aux personnes
        noires affichait bien plus souvent des publicités suggérant un casier judiciaire.
      </p>
      <p>
        L'anthropologue <strong>Mary L. Gray</strong> et l'informaticien Siddharth Suri appellent
        « travail fantôme » (<em>Ghost Work</em>, 2019) ce travail humain invisible. La
        sociologue <strong>Milagros Miceli</strong> l'étudie en Argentine et au Venezuela, puis
        lance avec l'institut DAIR une enquête menée par les travailleuses et travailleurs
        eux-mêmes. Au Kenya, le 1ᵉʳ mai 2023, plus de 150 modératrices et modérateurs de
        contenus, employés par des sous-traitants de Meta, TikTok et OpenAI, votent la création
        d'un syndicat.
      </p>
    </div>
    <div slot="decide">
      <p>
        <strong>Les lois.</strong> Le règlement européen sur l'IA (AI Act, règlement (UE)
        2024/1689) classe les usages selon leur niveau de risque. Depuis le 2 février 2025,
        certaines pratiques sont interdites, comme la notation sociale ; depuis le 2 août 2025,
        des règles s'appliquent aux modèles « à usage général » des grands assistants. En 2026,
        un règlement de simplification a repoussé à 2027 et 2028 les règles sur les systèmes
        « à haut risque ».
      </p>
      <p>
        <strong>Ouvert ou fermé ?</strong> Certains modèles publient leurs paramètres (« poids
        ouverts ») : Mistral AI (France) pour Mistral 7B en 2023, DeepSeek (Chine) pour R1 en
        2025, sous des licences libres. Meta présente ses modèles Llama comme « open source »,
        mais l'Open Source Initiative le conteste à cause des restrictions de leur licence ; sa
        définition (octobre 2024) exige aussi le code d'entraînement et une description
        détaillée des données. D'autres modèles restent entièrement fermés.
      </p>
      <p>
        <strong>L'énergie.</strong> Selon l'Agence internationale de l'énergie, les centres de
        données (pour l'IA et tout le reste) ont consommé environ 415 TWh d'électricité en 2024,
        environ 1,5 % de l'électricité mondiale ; elle en prévoit environ 945 TWh en 2030, l'IA
        étant le premier moteur de la hausse. Des chercheurs de l'université de Californie
        estiment que l'entraînement de GPT-3 a pu évaporer environ 700 000 litres d'eau douce.
      </p>
    </div>
  </Etape>

  <section class="final" id="bilan" data-ecran aria-labelledby="titre-final">
    <h2 id="titre-final">Et quand tu parles à un assistant ?</h2>
    <p>Chaque moment d'une conversation correspond à une étape que tu connais maintenant.</p>
    <table>
      <thead><tr><th scope="col">Ce qui se passe</th><th scope="col">L'étape</th></tr></thead>
      <tbody>
        <tr><td>Ta question est découpée en morceaux numérotés</td><td><a href="#tokens">1 — Les tokens</a></td></tr>
        <tr><td>Chaque morceau devient une liste de nombres</td><td><a href="#plongements">2 — Les plongements</a></td></tr>
        <tr><td>Chaque mot regarde les autres pour se comprendre</td><td><a href="#attention">5 — L'attention</a></td></tr>
        <tr><td>Des milliards de neurones calculent les probabilités du token suivant</td><td><a href="#neurone">3 — Le neurone</a> et <a href="#prediction">0 — Le mot suivant</a></td></tr>
        <tr><td>Un token est tiré au sort, ajouté, et l'on recommence</td><td><a href="#generation">6 — Écrire</a></td></tr>
        <tr><td>La réponse a l'air serviable et polie</td><td><a href="#fabrication">7 — Les coulisses</a> : l'ajustement par des humains</td></tr>
      </tbody>
    </table>

