<style>
  .chapo { font-size: 1.15rem; }
  .reglages { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin: 1.5rem 0; }
  .reglages .tag { margin: 0; }
  .frise {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    margin: 0 -1rem;
    padding: 0.5rem 1rem;
    overflow-x: auto;
  }
  .frise ol { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .frise a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    font-size: 0.9rem;
  }
  .frise a[aria-current='step'] { background: var(--accent); color: var(--bg); }
  .pastille {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-size: 0.8rem;
  }
  @media (max-width: 40rem) {
    .court { display: none; }
    .frise a[aria-current='step'] .court { display: inline; }
  }
  .pannes { padding-top: 2rem; border-top: 1px solid var(--border); }
  table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  td code { overflow-wrap: anywhere; }
</style>

<script>
  // Met en surbrillance, dans la frise, l'étape en cours de lecture.
  const frise = document.querySelector<HTMLElement>('.frise');
  const liens = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.frise a').forEach((a) => {
    liens.set(a.hash.slice(1), a);
  });
  const marquer = (id: string) => {
    liens.forEach((a, cle) => {
      if (cle === id) {
        a.setAttribute('aria-current', 'step');
        frise?.scrollTo({ left: a.offsetLeft - 16, behavior: 'smooth' });
      } else {
        a.removeAttribute('aria-current');
      }
    });
  };
  const observateur = new IntersectionObserver(
    (entrees) => {
      entrees.filter((e) => e.isIntersecting).forEach((e) => marquer(e.target.id));
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  document.querySelectorAll('.etape').forEach((s) => observateur.observe(s));
</script>
