// Faits sourcés : voir docs/sources/materialite.md.
const etapes = [
  { ancre: 'cables', court: 'Où passe ton message ?' },
  { ancre: 'centres', court: 'L’usine à calcul' },
  { ancre: 'telephone', court: 'Avant d’être allumé' },
  { ancre: 'combien', court: 'Une requête, combien ?' },
  { ancre: 'apres', court: 'Et après ?' },
  { ancre: 'bilan', court: 'Ce qu’il faut retenir', pastille: '✓' },
