      { auteur: 'CNIL', titre: 'Mots de passe : des recommandations de sécurité', url: 'https://cnil.fr/fr/mot-de-passe', type: 'primaire', annee: 2022 },
      { auteur: 'NIST', titre: 'SP 800-63B-4 : Authentication and Authenticator Management', url: 'https://pages.nist.gov/800-63-4/sp800-63b.html', type: 'primaire', annee: 2025, langue: 'en' },
