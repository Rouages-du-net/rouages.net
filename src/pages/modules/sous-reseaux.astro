      { auteur: 'M. Kohno, B. Nitzan, R. Bush, Y. Matsuzaki, L. Colitti, T. Narten', titre: 'RFC 6164, Using 127-Bit IPv6 Prefixes on Inter-Router Links', url: 'https://www.rfc-editor.org/rfc/rfc6164', type: 'primaire', annee: 2011, langue: 'en' },
      { auteur: 'J. Žorž, S. Steffann, P. Dražumerič, M. Townsley et al.', titre: 'RIPE-690, Best Current Operational Practice for Operators: IPv6 prefix assignment for end-users', url: 'https://www.ripe.net/publications/docs/ripe-690/', type: 'primaire', annee: 2017, langue: 'en', archive: 'http://web.archive.org/web/20260918234650/https://www.ripe.net/publications/docs/ripe-690/' },
      { auteur: 'G. Huston, A. Lord, P. Smith', titre: 'RFC 3849, IPv6 Address Prefix Reserved for Documentation', url: 'https://www.rfc-editor.org/rfc/rfc3849', type: 'primaire', annee: 2004, langue: 'en' },
    ]}
  />
  </section>
</Base>

