// Faits sourcés : voir docs/sources/intelligence-collective.md (thème 2).
const etapes = [
  { ancre: 'ecrire', court: 'Écrire ensemble' },
  { ancre: 'cartographier', court: 'Cartographier ensemble' },
  { ancre: 'galaxies', court: 'Classer des galaxies' },
  { ancre: 'communs', court: 'Des règles pour durer' },
  { ancre: 'qui-participe', court: 'Qui participe ?' },
