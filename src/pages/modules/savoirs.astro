      { auteur: 'B. Aczel, B. Szaszi, A. O. Holcombe', titre: 'A billion-dollar donation: estimating the cost of researchers’ time spent on peer review', url: 'https://link.springer.com/article/10.1186/s41073-021-00118-2', type: 'recherche', annee: 2021, langue: 'en' },
