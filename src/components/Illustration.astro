---
// Illustration libre (Wikimedia Commons) dans un cadre « photo agrafée » :
// un tirage papier légèrement penché, tenu par une agrafe, avec sa légende et
// son attribution complète (auteur, licence, source). Les fiches sont dans
// src/data/illustrations.json, les images dans src/assets/illustrations/ ;
// on les ajoute avec scripts/illustrations/importer.mjs (docs/ILLUSTRATIONS.md).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { FICHES, inclinaison } from '../lib/illustrations';

interface Props {
  id: string;
  /** Légende propre à cette page ; sinon celle de la fiche. */
  legende?: string;
  /** « droite » : posée à droite du texte sur grand écran ; « centre » : seule sur sa ligne. */
  place?: 'droite' | 'centre';
}
const { id, legende, place = 'droite' } = Astro.props;
const fiche = FICHES[id];
if (!fiche) throw new Error(`Illustration inconnue : « ${id} » (voir src/data/illustrations.json).`);
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/illustrations/*', { eager: true });
const image = images[`../assets/illustrations/${fiche.fichier}`]?.default;
if (!image) throw new Error(`Fichier manquant : src/assets/illustrations/${fiche.fichier}`);
const angle = inclinaison(id);
---
<figure class:list={['photo', place]} style={`--angle: ${angle}deg`}>
  <span class="agrafe" aria-hidden="true"></span>
  <Image src={image} alt={fiche.alt} widths={[320, 480, 720]} sizes="(max-width: 46rem) 90vw, 20rem" loading="lazy" decoding="async" />
  <figcaption>
    <span class="legende">{legende ?? fiche.legende}</span>
    <span class="credit">
      <a href={fiche.source}>{fiche.auteur}</a>,
      {fiche.licenceUrl ? <a href={fiche.licenceUrl}>{fiche.licence}</a> : fiche.licence}, via Wikimedia Commons
    </span>
  </figcaption>
</figure>

<style>
  .photo {
    position: relative;
    margin: 1.6rem auto;
    padding: 0.6rem 0.6rem 0.7rem;
    max-width: min(20rem, 100%);
    background: var(--photo-cadre);
    color: var(--sur-photo);
    border: 1px solid var(--border);
    box-shadow: var(--ombre);
    transform: rotate(var(--angle));
  }
  @media (min-width: 46rem) {
    .photo.droite { float: right; margin: 0.4rem 0 1rem 1.6rem; max-width: 17rem; }
  }
  .photo.centre { clear: both; max-width: min(26rem, 100%); }
  .photo :global(img) { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 0.5rem; font-size: 0.85rem; line-height: 1.45; }
  .legende { display: block; }
  .credit { display: block; margin-top: 0.3rem; font-size: 0.75rem; opacity: 0.85; overflow-wrap: anywhere; }
  .credit a { color: var(--sur-photo-lien); }
  /* L'agrafe : deux pattes et un dos, en travers du coin haut. */
  .agrafe {
    position: absolute; top: -0.55rem; left: 50%; width: 3.2rem; height: 0.75rem;
    transform: translateX(-50%) rotate(calc(var(--angle) * -2));
    border: 3px solid var(--agrafe); border-bottom: none; border-radius: 3px 3px 0 0;
    background: linear-gradient(var(--agrafe-reflet), transparent 70%);
  }
  .agrafe::after {
    content: ''; position: absolute; left: 0.2rem; right: 0.2rem; top: 0.2rem; height: 2px; background: var(--agrafe-reflet);
  }
</style>
