---
// Animation « Le voyage des paquets » (étape 5 du module « De l'Entrée à
// la page »).
//
// Un petit réseau avec des routes de secours. Le paquet suit le plus court
// chemin, saut par saut ; son TTL baisse à chaque routeur (c'est ce
// qu'exploite traceroute). On peut couper des liens : la route se
// recalcule, comme le font les routeurs avec BGP et les protocoles internes.
// Le réseau est un exemple simplifié : les noms de villes sont illustratifs.
//
// Variante « serveur lointain » : le serveur est à New York ; le paquet
// traverse l'Atlantique par l'un de deux câbles sous-marins. Délai minimal
// calculé à la construction : distance orthodromique Paris – New York
// (≈ 5 837 km) divisée par la vitesse de la lumière dans une fibre standard,
// c / 1,47 (indice de groupe de la fibre SMF-28 : Antesberger et al., 2023,
// voir docs/sources/entree-a-la-page.md). Les vrais câbles sont plus longs.

const C_VIDE = 299792.458; // km/s, valeur exacte (définition du mètre, SI)
const INDICE_FIBRE = 1.47;
const DISTANCE_PARIS_NY = 5837; // km, en ligne droite sur le globe
const allerMs = Math.round((DISTANCE_PARIS_NY / (C_VIDE / INDICE_FIBRE)) * 1000);
const retourMs = Math.round(((2 * DISTANCE_PARIS_NY) / (C_VIDE / INDICE_FIBRE)) * 1000);
const vitesseFibre = Math.round(C_VIDE / INDICE_FIBRE / 1000) * 1000;

const noeuds = [
  { id: 'box', nom: 'Ta box', sous: 'chez toi', x: 70, y: 170, role: 'client' },
  { id: 'fai1', nom: 'Ton fournisseur', sous: 'routeur, Lyon', x: 225, y: 85, role: 'reseau' },
  { id: 'fai2', nom: 'Ton fournisseur', sous: 'routeur, Marseille', x: 225, y: 255, role: 'reseau' },
  // Un point d'échange est un grand commutateur (couche 2) : il ne
  // décrémente pas le TTL et n'apparaît pas comme un saut de traceroute.
  { id: 'ixp', nom: "Point d'échange", sous: 'Paris', x: 400, y: 85, role: 'reseau', commutateur: true },
  { id: 'transit', nom: 'Opérateur de transit', sous: 'liaison payante', x: 400, y: 255, role: 'reseau' },
  { id: 'heb', nom: 'Hébergeur', sous: 'routeur du datacenter', x: 565, y: 170, role: 'reseau', mode: 'fr' },
  { id: 'srv', nom: 'Serveur', sous: 'rouages.net', x: 720, y: 170, role: 'serveur', mode: 'fr' },
  // Variante lointaine. Un câble n'est pas un routeur : la lumière le
  // traverse (amplifiée en chemin) sans que le TTL change.
  { id: 'ca', nom: 'Câble sous-marin', sous: 'Atlantique, route A', x: 565, y: 85, role: 'cable', mode: 'ny', transparent: 'pas un routeur, TTL inchangé' },
  { id: 'cb', nom: 'Câble sous-marin', sous: 'Atlantique, route B', x: 565, y: 255, role: 'cable', mode: 'ny', transparent: 'pas un routeur, TTL inchangé' },
  { id: 'nyr', nom: 'Routeur', sous: 'New York', x: 720, y: 110, role: 'reseau', mode: 'ny' },
  { id: 'srvny', nom: 'Serveur', sous: 'à New York', x: 720, y: 235, role: 'serveur', mode: 'ny' },
];

const liens: [string, string][] = [
  ['box', 'fai1'],
  ['box', 'fai2'],
  ['fai1', 'fai2'],
  ['fai1', 'ixp'],
  ['fai2', 'transit'],
  ['ixp', 'transit'],
  ['ixp', 'heb'],
  ['transit', 'heb'],
  ['heb', 'srv'],
  ['ixp', 'ca'],
  ['transit', 'cb'],
  ['ca', 'nyr'],
  ['cb', 'nyr'],
  ['nyr', 'srvny'],
];

const nom = (id: string) => {
  const n = noeuds.find((x) => x.id === id)!;
  return `${n.nom} (${n.sous})`;
};
const etiquetteLien = ([a, b]: [string, string]) => `${nom(a)} – ${nom(b)}`;
---
<div class="voyage" data-voyage data-noeuds={JSON.stringify(noeuds)} data-liens={JSON.stringify(liens)} data-delai={JSON.stringify({ allerMs, retourMs, vitesseFibre })}>
  <div class="texte-etapes">
    <p>
      Sans coupure, le paquet quitte ton ordinateur avec un TTL de 64 (le nombre de routeurs qu'il a encore le droit de traverser), passe par ta
      box, par le routeur de ton fournisseur d'accès à Lyon, par le point d'échange de
      Paris, entre chez l'hébergeur et arrive au serveur. Chaque routeur traversé, box
      comprise, baisse son TTL de 1 ; le point d'échange, lui, est un grand commutateur
      qui ne compte pas comme un saut. Le paquet arrive avec un TTL de 61. Si le lien
      Lyon – Paris est coupé, les routeurs trouvent une autre route, par exemple par
      Marseille et un opérateur de transit.
    </p>
    <p>
      Si le serveur est à New York, le paquet traverse l'Atlantique par un câble
      sous-marin. Même à la vitesse de la lumière dans la fibre (environ
      {vitesseFibre.toLocaleString('fr-FR')} km/s), les quelque 5 800 km en ligne droite
      demandent au moins {allerMs} ms à l'aller et {retourMs} ms pour l'aller-retour.
    </p>
  </div>

  <div class="scene" hidden>
    <fieldset class="destination">
      <legend>Où est le serveur ?</legend>
      <label><input type="radio" name="voyage-dest" value="fr" checked /> En France</label>
      <label><input type="radio" name="voyage-dest" value="ny" /> À New York (de l'autre côté de l'Atlantique)</label>
    </fieldset>
    <div class="cadre">
      <svg viewBox="0 0 790 330" role="img" aria-labelledby="voyage-titre">
        <title id="voyage-titre">Réseau simplifié entre ta box et le serveur, avec plusieurs routes possibles.</title>
        <g class="liens">
          {liens.map(([a, b], i) => {
            const na = noeuds.find((n) => n.id === a)!;
            const nb = noeuds.find((n) => n.id === b)!;
            return (
              <g class="lien" data-lien={i} data-mode={[na, nb].find((n) => 'mode' in n)?.mode}>
                <line class="trait" x1={na.x} y1={na.y} x2={nb.x} y2={nb.y} />
                <line class="zone" x1={na.x} y1={na.y} x2={nb.x} y2={nb.y}>
                  <title>Couper ou rétablir : {etiquetteLien([a, b])}</title>
                </line>
                <text class="coupure" x={(na.x + nb.x) / 2} y={(na.y + nb.y) / 2 + 6}>✕</text>
              </g>
            );
          })}
        </g>
        {noeuds.map((n) => (
          <g class={`noeud ${n.role}`} data-noeud={n.id} data-mode={n.mode} transform={`translate(${n.x} ${n.y})`}>
            <rect x="-66" y="-27" width="132" height="54" rx="10" />
            <text y="-3" class="nom">{n.nom}</text>
            <text y="15" class="sous">{n.sous}</text>
          </g>
        ))}
        <g class="paquet" transform="translate(70 170)" visibility="hidden">
          <rect x="-26" y="-13" width="52" height="26" rx="6" />
          <text y="5">TTL 64</text>
        </g>
      </svg>
    </div>

    <p class="route" aria-live="polite"></p>

    <div class="commandes">
      <button type="button" data-action="envoyer" class="principal">Envoyer un paquet ▶</button>
      <button type="button" data-action="retablir">↺ Rétablir tous les liens</button>
    </div>

    <details class="couper">
      <summary>Coupe un lien (ou clique sur un trait du schéma)</summary>
      <ul>
        {liens.map((l, i) => (
          <li data-mode={noeuds.find((n) => (n.id === l[0] || n.id === l[1]) && 'mode' in n)?.mode}>
            <label><input type="checkbox" data-lien-case={i} /> {etiquetteLien(l)}</label>
          </li>
        ))}
      </ul>
    </details>

    <div class="traceroute">
      <p class="titre-trace">Ce que verrait <code>traceroute</code> :</p>
      <ol class="sauts"></ol>
    </div>
  </div>
</div>

<script>
  import { deplacer, mouvementReduit } from '../../lib/anim';

  interface Noeud {
    id: string; nom: string; sous: string; x: number; y: number;
    commutateur?: boolean; transparent?: string; mode?: 'fr' | 'ny';
  }

  document.querySelectorAll<HTMLElement>('[data-voyage]').forEach((racine) => {
    const noeuds: Noeud[] = JSON.parse(racine.dataset.noeuds!);
    const liens: [string, string][] = JSON.parse(racine.dataset.liens!);
    const pos = (id: string) => noeuds.find((n) => n.id === id)!;
    // Le paquet circule juste au-dessus des nœuds, pour ne pas masquer leur nom.
    const ancre = (id: string) => ({ x: pos(id).x, y: pos(id).y - 40 });
    const nom = (id: string) => `${pos(id).nom} (${pos(id).sous})`;

    racine.querySelector<HTMLElement>('.texte-etapes')!.hidden = true;
    racine.querySelector<HTMLElement>('.scene')!.hidden = false;

    const paquet = racine.querySelector<SVGGElement>('.paquet')!;
    const ttlTexte = paquet.querySelector('text')!;
    const route = racine.querySelector<HTMLElement>('.route')!;
    const sauts = racine.querySelector<HTMLOListElement>('.sauts')!;
    const envoyer = racine.querySelector<HTMLButtonElement>('[data-action="envoyer"]')!;
    const coupes = new Set<number>();
    const delai: { allerMs: number; retourMs: number; vitesseFibre: number } = JSON.parse(racine.dataset.delai!);
    let enCours = false;
    let dest: 'fr' | 'ny' = 'fr';
    const cible = () => (dest === 'fr' ? 'srv' : 'srvny');
    const present = (id: string) => {
      const m = pos(id).mode;
      return !m || m === dest;
    };

    function appliquerMode() {
      racine.querySelectorAll<SVGElement | HTMLElement>('[data-mode]').forEach((el) => {
        const absent = el.dataset.mode !== dest;
        if (el instanceof HTMLElement) el.hidden = absent;
        else el.style.display = absent ? 'none' : '';
      });
    }

    /** Plus court chemin (en nombre de sauts) par parcours en largeur. */
    function chemin(): string[] | null {
      const voisins = new Map<string, string[]>();
      liens.forEach(([a, b], i) => {
        if (coupes.has(i) || !present(a) || !present(b)) return;
        voisins.set(a, [...(voisins.get(a) ?? []), b]);
        voisins.set(b, [...(voisins.get(b) ?? []), a]);
      });
      const prec = new Map<string, string>([['box', '']]);
      const file = ['box'];
      while (file.length) {
        const n = file.shift()!;
        if (n === cible()) break;
        for (const v of voisins.get(n) ?? []) {
          if (!prec.has(v)) {
            prec.set(v, n);
            file.push(v);
          }
        }
      }
      if (!prec.has(cible())) return null;
      const res = [cible()];
      while (res[0] !== 'box') res.unshift(prec.get(res[0])!);
      return res;
    }

    function dessiner() {
      const c = chemin();
      const surRoute = new Set<string>();
      c?.slice(1).forEach((n, i) => surRoute.add([c[i], n].sort().join('|')));
      racine.querySelectorAll<SVGGElement>('.lien').forEach((g) => {
        const i = Number(g.dataset.lien);
        g.classList.toggle('coupe', coupes.has(i));
        g.classList.toggle('actif', surRoute.has([...liens[i]].sort().join('|')));
      });
      racine.querySelectorAll<HTMLInputElement>('[data-lien-case]').forEach((cb) => {
        cb.checked = coupes.has(Number(cb.dataset.lienCase));
      });
      route.textContent = c
        ? `Route actuelle : ${c.map(nom).join(' → ')}.`
        : "Plus aucune route : le serveur est injoignable. Ton navigateur finira par afficher « La connexion a expiré ».";
      envoyer.disabled = !c || enCours;
    }

    function basculer(i: number) {
      if (enCours) return;
      coupes.has(i) ? coupes.delete(i) : coupes.add(i);
      sauts.replaceChildren();
      dessiner();
    }

    async function envoyerPaquet() {
      const c = chemin();
      if (!c || enCours) return;
      enCours = true;
      dessiner();
      sauts.replaceChildren();
      // Le paquet quitte ton ordinateur avec un TTL de 64 ; la box est déjà
      // un routeur : elle le décrémente (premier saut de traceroute).
      let ttl = 63;
      ttlTexte.textContent = `TTL ${ttl}`;
      paquet.setAttribute('visibility', 'visible');
      paquet.setAttribute('transform', `translate(${ancre('box').x} ${ancre('box').y})`);
      let numero = 1;
      const premier = document.createElement('li');
      premier.value = numero;
      premier.textContent = `${nom('box')} — TTL ramené de 64 à 63`;
      sauts.append(premier);
      for (let i = 1; i < c.length; i++) {
        await deplacer(paquet, ancre(c[i - 1]), ancre(c[i]), 650);
        // Chaque routeur traversé décrémente le TTL ; ni le commutateur du
        // point d'échange, ni un câble, ni le serveur de destination.
        const n = pos(c[i]);
        const arrive = c[i] === cible();
        if (!arrive && !n.commutateur && !n.transparent) ttl--;
        ttlTexte.textContent = `TTL ${ttl}`;
        const li = document.createElement('li');
        if (n.commutateur || n.transparent) {
          // Invisible pour traceroute : on l'indique à part, sans numéro.
          li.className = 'hors-saut';
          li.textContent = n.commutateur
            ? `(${nom(c[i])} : grand commutateur, ne compte pas comme un saut, TTL inchangé)`
            : `(${nom(c[i])} : ${n.transparent})`;
        } else {
          li.value = ++numero;
          li.textContent = arrive ? `${nom(c[i])} : arrivé avec un TTL de ${ttl} !` : `${nom(c[i])} — TTL ramené à ${ttl}`;
        }
        sauts.append(li);
        if (!mouvementReduit()) await new Promise((r) => setTimeout(r, 200));
      }
      enCours = false;
      dessiner();
      if (dest === 'ny') {
        route.textContent =
          `Traversée de l'Atlantique : environ 5 800 km en ligne droite. Même à la vitesse de la lumière dans la fibre ` +
          `(environ ${delai.vitesseFibre.toLocaleString('fr-FR')} km/s), il faut au moins ${delai.allerMs} ms pour l'aller ` +
          `et ${delai.retourMs} ms pour l'aller-retour. Les vrais câbles, plus longs que la ligne droite, en ajoutent encore.`;
      }
    }

    racine.querySelectorAll<SVGGElement>('.lien').forEach((g) => {
      g.addEventListener('click', () => basculer(Number(g.dataset.lien)));
    });
    racine.querySelectorAll<HTMLInputElement>('[data-lien-case]').forEach((cb) => {
      cb.addEventListener('change', () => basculer(Number(cb.dataset.lienCase)));
    });
    envoyer.addEventListener('click', envoyerPaquet);
    racine.querySelectorAll<HTMLInputElement>('input[name="voyage-dest"]').forEach((r) =>
      r.addEventListener('change', () => {
        if (enCours) return;
        dest = r.value as 'fr' | 'ny';
        coupes.clear();
        sauts.replaceChildren();
        paquet.setAttribute('visibility', 'hidden');
        appliquerMode();
        dessiner();
      }),
    );
    racine.querySelector('[data-action="retablir"]')!.addEventListener('click', () => {
      if (enCours) return;
      coupes.clear();
      sauts.replaceChildren();
      dessiner();
    });

    appliquerMode();
    dessiner();
  });
</script>

<style>
  .voyage { margin: 1rem 0; }
  .cadre {
    overflow-x: auto;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
  }
  svg { display: block; width: 100%; min-width: 36rem; height: auto; }
  .lien .trait { stroke: var(--ill-reseau); stroke-width: 2.5; stroke-linecap: round; }
  .lien.actif .trait { stroke: var(--ill-paquet); stroke-width: 5; }
  .lien.coupe .trait { stroke: var(--border); stroke-dasharray: 6 8; }
  .lien .zone { stroke: transparent; stroke-width: 18; cursor: pointer; }
  .lien .coupure { display: none; fill: var(--accent); font-size: 18px; font-weight: 700; text-anchor: middle; pointer-events: none; }
  .lien.coupe .coupure { display: inline; }
  .noeud rect { fill: var(--card); stroke: var(--ill-reseau); stroke-width: 2; }
  .noeud.client rect { stroke: var(--ill-client); stroke-width: 3; }
  .noeud.serveur rect { stroke: var(--ill-serveur); stroke-width: 3; }
  .noeud.cable rect { stroke: var(--ill-paquet); stroke-dasharray: 3 4; }
  .destination { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; border: none; padding: 0; margin: 0 0 0.5rem; font-size: 0.9rem; }
  .destination legend { font-weight: 600; margin-bottom: 0.25rem; }
  .noeud text { text-anchor: middle; fill: var(--fg); font-family: var(--police); pointer-events: none; }
  .noeud .nom { font-size: 13px; font-weight: 700; }
  .noeud .sous { font-size: 11.5px; fill: var(--muted); }
  .paquet rect { fill: var(--ill-paquet); }
  .paquet text { fill: var(--bg); font-size: 11.5px; font-weight: 700; text-anchor: middle; font-family: var(--police-mono); }
  .route { margin: 0.75rem 0 0; font-weight: 600; min-height: 3em; }
  .commandes { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .commandes button {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg);
    cursor: pointer;
  }
  .commandes .principal { background: var(--accent); color: var(--bg); border-color: var(--accent); }
  .commandes button:disabled { opacity: 0.45; cursor: default; }
  .couper, .traceroute {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 0.6rem 0.9rem;
  }
  .couper summary { cursor: pointer; font-weight: 600; }
  .couper ul { list-style: none; padding: 0; margin: 0.5rem 0 0; columns: 2 16rem; }
  .titre-trace { margin: 0; font-weight: 600; }
  .sauts :global(.hors-saut) { list-style: none; color: var(--muted); }
  .sauts { margin: 0.25rem 0 0; padding-left: 1.5rem; font-family: var(--police-mono); font-size: 0.85rem; min-height: 1.5em; }
</style>
