---
// Frise interactive de l'histoire d'internet, filtrable par région, par thème
// et pour mettre en avant les pionnières (voir docs/VISION.md, § 3). Sans
// JavaScript, la frise complète s'affiche ; les filtres ne font que masquer.
import { EVENEMENTS, REGIONS, THEMES } from '../../../data/histoire-internet';
const evts = [...EVENEMENTS].sort((a, b) => a.tri - b.tri);
---
<div class="frise-histoire" data-frise-internet>
  <div class="filtres" hidden data-filtres>
    <fieldset>
      <legend>Région</legend>
      <label><input type="radio" name="region-internet" value="" checked /> toutes</label>
      {Object.entries(REGIONS).map(([v, l]) => <label><input type="radio" name="region-internet" value={v} /> {l}</label>)}
    </fieldset>
    <fieldset>
      <legend>Thème</legend>
      <label><input type="radio" name="theme-internet" value="" checked /> tous</label>
      {Object.entries(THEMES).map(([v, l]) => <label><input type="radio" name="theme-internet" value={v} /> {l}</label>)}
    </fieldset>
    <label class="case"><input type="checkbox" data-pionnieres /> seulement les pionnières</label>
    <p class="compte" aria-live="polite" data-compte></p>
  </div>

  <ol class="evenements">
    {evts.map((e) => (
      <li data-region={e.region} data-theme={e.theme} data-pionniere={e.pionniere ? '1' : '0'} class={`theme-${e.theme}`}>
        <p class="annee">{e.annee}</p>
        <div class="corps">
          <h3>{e.titre}</h3>
          <p>{e.texte}</p>
          <p class="meta">
            <span class="etiquette">{REGIONS[e.region]}</span>
            <span class="etiquette">{THEMES[e.theme]}</span>
            {e.personnes?.map((p) => <span class="etiquette personne">{p}</span>)}
          </p>
          <p class="source">Source : <a href={e.source.url}>{e.source.titre}</a></p>
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-frise-internet]').forEach((racine) => {
    const filtres = racine.querySelector<HTMLElement>('[data-filtres]')!;
    filtres.hidden = false;
    const items = [...racine.querySelectorAll<HTMLElement>('.evenements > li')];
    const compte = racine.querySelector<HTMLElement>('[data-compte]')!;
    const pionnieres = racine.querySelector<HTMLInputElement>('[data-pionnieres]')!;
    const val = (n: string) => racine.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)!.value;

    function maj() {
      const r = val('region-internet'), t = val('theme-internet');
      let n = 0;
      items.forEach((li) => {
        const ok = (!r || li.dataset.region === r) && (!t || li.dataset.theme === t) && (!pionnieres.checked || li.dataset.pionniere === '1');
        li.hidden = !ok;
        if (ok) n++;
      });
      compte.textContent = n === 0 ? 'Aucun événement avec ces filtres.' : n === 1 ? '1 événement affiché.' : `${n} événements affichés sur ${items.length}.`;
    }
    racine.querySelectorAll('input').forEach((i) => i.addEventListener('input', maj));
    maj();
  });
</script>

<style>
  .filtres { background: var(--card); border: 1px solid var(--border); border-radius: 0.75rem; padding: 0.75rem 1rem; margin-bottom: 1rem; display: grid; gap: 0.5rem; }
  .filtres[hidden] { display: none; }
  .filtres fieldset { border: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; font-size: 0.95rem; }
  .filtres legend { font-weight: 700; margin-bottom: 0.25rem; width: 100%; }
  .filtres input { accent-color: var(--accent); }
  .case { font-size: 0.95rem; }
  .compte { margin: 0; color: var(--muted); font-size: 0.9rem; }
  .evenements { list-style: none; padding: 0; margin: 0; border-left: 3px solid var(--border); }
  .evenements > li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.75rem; padding: 0.75rem 0 0.75rem 1rem; position: relative; }
  .evenements > li::before { content: ''; position: absolute; left: -0.55rem; top: 1.05rem; width: 0.8rem; height: 0.8rem; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); }
  .theme-reseaux::before { background: var(--ill-client) !important; }
  .theme-noms::before { background: var(--ill-secret-a) !important; }
  .theme-web::before { background: var(--ill-paquet) !important; }
  .theme-infra::before { background: var(--ill-serveur) !important; }
  .annee { margin: 0; font-family: var(--police-mono); font-weight: 700; }
  .corps h3 { margin: 0 0 0.25rem; font-size: 1.05rem; }
  .corps p { margin: 0 0 0.35rem; max-width: var(--mesure); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .etiquette { font-size: 0.78rem; padding: 0.05rem 0.45rem; border: 1px solid var(--border); border-radius: 999px; color: var(--muted); }
  .etiquette.personne { color: var(--fg); }
  .source { font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 30rem) { .evenements > li { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
