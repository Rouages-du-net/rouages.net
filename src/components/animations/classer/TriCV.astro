---
// Animation « Quand le classement touche des personnes » (étape 4 du module
// « Les IA qui classent ») : un arbre de décision apprend à trier des
// candidatures à partir de 300 décisions passées (inventées). Les
// recruteur·ses d'autrefois écartaient les carrières interrompues, surtout
// celles de femmes. Retirer la colonne « genre » ne suffit pas : l'arbre
// retrouve le même biais par l'interruption de carrière.
---
<div class="anim tri-cv" data-tri-cv>
  <div class="anim-repli">
    <p>
      Une entreprise entraîne une IA sur 300 décisions de recrutement passées. Autrefois, on
      écartait presque toujours les candidatures avec une interruption de carrière, qui
      concernent bien plus de femmes (congé parental). Résultat : parmi des candidatures
      également qualifiées (diplôme et expérience), l'IA retient environ 94 % des hommes mais
      seulement 57 % des femmes. Retirer la colonne « genre » ne change rien : l'interruption
      de carrière sert de « variable indirecte ». Il faut comprendre d'où vient le biais pour
      le corriger.
    </p>
  </div>

  <div class="anim-scene" hidden>
    <div class="anim-cadre">
      <fieldset class="colonnes">
        <legend>Colonnes données à l'IA</legend>
        <label><input type="checkbox" checked disabled /> diplôme</label>
        <label><input type="checkbox" checked disabled /> au moins 5 ans d'expérience</label>
        <label><input type="checkbox" data-col="interruption" checked /> interruption de carrière</label>
        <label><input type="checkbox" data-col="femme" checked /> genre</label>
      </fieldset>
      <div class="deux">
        <div>
          <h4>Ce que l'IA a appris</h4>
          <pre class="dessin" data-dessin></pre>
        </div>
        <div>
          <h4>Nouvelles candidatures qualifiées : part retenue</h4>
          <div class="barre-groupe"><span>Femmes</span><span class="barre"><span data-barre="f"></span></span><strong data-taux="f"></strong></div>
          <div class="barre-groupe"><span>Hommes</span><span class="barre"><span data-barre="h"></span></span><strong data-taux="h"></strong></div>
          <p class="note">« Qualifiées » : avec diplôme et au moins 5 ans d'expérience (environ 130 sur 400 nouvelles candidatures). Données inventées pour l'exemple.</p>
        </div>
      </div>
      <p class="anim-legende" aria-live="polite"></p>
    </div>
  </div>
</div>

<script>
  import { activerScene } from '../../../lib/pasapas';
  import { apprendreArbre, classer, arbreEnTexte } from '../../../lib/apprendre';
  import { historique } from '../../../lib/classer';
  import { hasard } from '../../../lib/minilm';

  const TEXTES: Record<string, string> = {
    diplome: 'diplôme',
    experience: 'au moins 5 ans d’expérience',
    interruption: 'interruption de carrière',
    femme: 'est une femme',
  };
  const passe = historique(hasard(4), 300);
  const nouvelles = historique(hasard(9), 400).filter((c) => c.diplome && c.experience);
  const exemples = passe.map((c) => ({ nom: '', attributs: { ...c }, classe: c.retenue ? 'retenue' : 'écartée' }));

  document.querySelectorAll<HTMLElement>('[data-tri-cv]').forEach((racine) => {
    activerScene(racine);
    const cases = [...racine.querySelectorAll<HTMLInputElement>('[data-col]')];
    const legende = racine.querySelector<HTMLElement>('.anim-legende')!;

    function maj() {
      const colonnes = ['diplome', 'experience', ...cases.filter((c) => c.checked).map((c) => c.dataset.col!)];
      const arbre = apprendreArbre(exemples, colonnes);
      racine.querySelector('[data-dessin]')!.textContent = arbreEnTexte(arbre, TEXTES).replaceAll('→ ', '→ candidature ');
      const taux = (femme: boolean) => {
        const groupe = nouvelles.filter((c) => c.femme === femme);
        return Math.round((groupe.filter((c) => classer(arbre, { ...c }).classe === 'retenue').length / groupe.length) * 100);
      };
      const [f, h] = [taux(true), taux(false)];
      for (const [k, v] of [['f', f], ['h', h]] as const) {
        racine.querySelector<HTMLElement>(`[data-barre="${k}"]`)!.style.width = `${v}%`;
        racine.querySelector(`[data-taux="${k}"]`)!.textContent = `${v} %`;
      }
      const genre = colonnes.includes('femme');
      const inter = colonnes.includes('interruption');
      legende.textContent = inter
        ? `${genre ? 'L’IA a reproduit les décisions du passé' : 'Sans la colonne « genre », rien ne change'} : ${f} % des femmes qualifiées retenues, contre ${h} % des hommes. ${genre ? 'Retire la colonne « genre » pour voir.' : 'L’interruption de carrière, bien plus fréquente chez les femmes, transmet le même biais. Retire aussi cette colonne.'}`
        : `Sans l’interruption de carrière, l’écart disparaît : ${f} % et ${h} %. Mais attention : on n’efface pas toujours un biais en retirant une colonne. Il faut d’abord mesurer les écarts, groupe par groupe.`;
    }
    cases.forEach((c) => c.addEventListener('change', maj));
    maj();
  });
</script>

<style>
  .colonnes { display: flex; flex-wrap: wrap; gap: 0.3rem 1.1rem; border: 1px solid var(--border); border-radius: 0.75rem; padding: 0.6rem 0.9rem; margin: 0 0 0.75rem; }
  .colonnes legend { font-weight: 600; padding: 0 0.3rem; }
  .colonnes label { font-size: 0.9rem; display: inline-flex; gap: 0.35rem; align-items: center; }
  .deux { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  h4 { margin: 0 0 0.5rem; font-size: 0.95rem; }
  .dessin { font-size: 0.8rem; margin: 0; white-space: pre-wrap; background: var(--bg); border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.5rem; }
  .barre-groupe { display: grid; grid-template-columns: 4.5rem 1fr 3.5rem; gap: 0.5rem; align-items: center; margin-bottom: 0.4rem; }
  .barre-groupe strong { font-family: var(--police-mono); text-align: right; }
  .barre { height: 0.9rem; background: var(--bg); border: 1px solid var(--border); border-radius: 999px; overflow: hidden; }
  .barre span { display: block; height: 100%; background: var(--ill-secret-a); transition: width 0.3s; }
  .note { font-size: 0.85rem; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .barre span { transition: none; } }
</style>
