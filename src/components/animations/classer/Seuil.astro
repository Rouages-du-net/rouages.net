---
// Animation « Le seuil » (étape 2 du module « Les IA qui classent ») : le
// filtre bayésien donne une probabilité de spam à 24 courriels qu'il n'a
// jamais vus. On déplace le seuil au-delà duquel un courriel est bloqué et
// l'on suit la matrice de confusion : moins de spams qui passent, ou moins
// de vrais courriels perdus ?
---
<div class="anim seuil" data-seuil>
  <div class="anim-repli">
    <p>
      Le filtre donne à chaque courriel une probabilité d'être un spam. Il faut choisir un
      seuil : au-dessus, le courriel part dans les indésirables. Avec un seuil bas, presque
      tous les spams sont bloqués, mais de vrais courriels aussi (faux positifs). Avec un
      seuil haut, on ne perd plus de vrais courriels, mais des spams passent (faux négatifs).
      Sur nos 24 courriels d'examen, à 50 % : 12 spams bloqués sur 12, mais 4 courriels
      normaux perdus ; à 99 % : aucun courriel normal perdu, mais 3 spams qui passent.
    </p>
  </div>

  <div class="anim-scene" hidden>
    <div class="anim-cadre">
      <svg viewBox="0 0 320 96" role="img" aria-labelledby="seuil-titre">
        <title id="seuil-titre">Les 24 courriels placés selon leur probabilité de spam, et le seuil.</title>
        <line x1="10" y1="70" x2="310" y2="70" class="axe" />
        <text x="10" y="88" class="graduation">0 %</text>
        <text x="160" y="88" class="graduation">50 %</text>
        <text x="310" y="88" class="graduation">100 %</text>
        <rect data-zone x="160" y="4" width="150" height="66" class="zone" />
        <g data-points></g>
        <line data-ligne x1="160" y1="2" x2="160" y2="74" class="ligne" />
      </svg>
      <label class="curseur">Seuil de blocage : <output data-sortie></output>
        <input type="range" min="0" max="100" step="1" value="50" data-seuil-val />
      </label>
      <table class="matrice">
        <caption>Matrice de confusion (24 courriels jamais vus)</caption>
        <thead><tr><td></td><th scope="col">Bloqué</th><th scope="col">Reçu</th></tr></thead>
        <tbody>
          <tr><th scope="row">Vrai spam</th><td class="bien" data-m="vraisPositifs"></td><td class="mal" data-m="fauxNegatifs"></td></tr>
          <tr><th scope="row">Vrai courriel</th><td class="mal" data-m="fauxPositifs"></td><td class="bien" data-m="vraisNegatifs"></td></tr>
        </tbody>
      </table>
      <p class="cle"><span class="c-spam">●</span> spam <span class="c-normal">●</span> courriel normal · zone grisée : bloqué</p>
      <p class="anim-legende" aria-live="polite"></p>
    </div>
  </div>
</div>

<script>
  import { activerScene } from '../../../lib/pasapas';
  import { FiltreBayes, ENTRAINEMENT, EXAMEN, confusion } from '../../../lib/classer';

  const NS = 'http://www.w3.org/2000/svg';
  // Échelle « logit » : les probabilités proches de 0 ou de 1 restent visibles.
  const logit = (p: number) => Math.log(Math.max(1e-4, p) / Math.max(1e-4, 1 - p));
  const X = (p: number) => 160 + Math.max(-1, Math.min(1, logit(p) / 7)) * 150;
  const seuilDe = (v: number) => (v <= 50 ? 0.01 + (v / 50) * 0.49 : 0.5 + ((v - 50) / 50) * 0.495);

  document.querySelectorAll<HTMLElement>('[data-seuil]').forEach((racine) => {
    activerScene(racine);
    const filtre = new FiltreBayes(ENTRAINEMENT);
    const resultats = EXAMEN.map((c) => ({ p: filtre.juger(c).p, etiquette: c.etiquette, objet: c.objet }));
    const curseur = racine.querySelector<HTMLInputElement>('[data-seuil-val]')!;
    const sortie = racine.querySelector<HTMLOutputElement>('[data-sortie]')!;
    const ligne = racine.querySelector<SVGLineElement>('[data-ligne]')!;
    const zone = racine.querySelector<SVGRectElement>('[data-zone]')!;
    const legende = racine.querySelector<HTMLElement>('.anim-legende')!;

    // Les points, empilés quand ils tombent au même endroit.
    const piles = new Map<number, number>();
    racine.querySelector('[data-points]')!.append(
      ...resultats.map((r) => {
        const x = Math.round(X(r.p) / 8) * 8;
        const n = piles.get(x) ?? 0;
        piles.set(x, n + 1);
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', String(x));
        c.setAttribute('cy', String(62 - n * 9));
        c.setAttribute('r', '4');
        c.setAttribute('class', r.etiquette);
        const t = document.createElementNS(NS, 'title');
        t.textContent = `${r.objet} (${r.etiquette})`;
        c.append(t);
        return c;
      }),
    );

    function maj() {
      const s = seuilDe(Number(curseur.value));
      sortie.value = `${(s * 100).toFixed(s > 0.95 ? 1 : 0).replace('.', ',')} %`;
      const x = X(s);
      ligne.setAttribute('x1', String(x));
      ligne.setAttribute('x2', String(x));
      zone.setAttribute('x', String(x));
      zone.setAttribute('width', String(310 - x));
      const m = confusion(resultats, s);
      for (const [cle, v] of Object.entries(m)) racine.querySelector(`[data-m="${cle}"]`)!.textContent = String(v);
      legende.textContent = `${m.vraisPositifs} spams bloqués sur 12 ; ${m.fauxNegatifs} spam${m.fauxNegatifs > 1 ? 's' : ''} qui passe${m.fauxNegatifs > 1 ? 'nt' : ''} (faux négatifs) ; ${m.fauxPositifs} vrai${m.fauxPositifs > 1 ? 's' : ''} courriel${m.fauxPositifs > 1 ? 's' : ''} perdu${m.fauxPositifs > 1 ? 's' : ''} dans les indésirables (faux positifs). ${
        m.fauxPositifs && m.fauxNegatifs ? 'Les deux erreurs à la fois.' : m.fauxPositifs ? 'Pour ne rater aucun spam, on sacrifie de vrais courriels.' : m.fauxNegatifs ? 'Plus aucun vrai courriel perdu… mais des spams passent.' : 'Parfait sur ces 24 courriels : rare dans la vraie vie.'
      }`;
    }
    curseur.addEventListener('input', maj);
    maj();
  });
</script>

<style>
  svg { width: 100%; max-width: 34rem; height: auto; display: block; margin: 0 auto; }
  .axe { stroke: var(--border); stroke-width: 2; }
  .graduation { fill: var(--muted); font: 10px var(--police); text-anchor: middle; }
  .zone { fill: color-mix(in oklab, var(--muted) 14%, transparent); }
  .ligne { stroke: var(--fg); stroke-width: 2; stroke-dasharray: 4 3; }
  svg :global(circle.spam), .c-spam { fill: var(--ill-paquet); color: var(--ill-paquet); }
  svg :global(circle.normal), .c-normal { fill: var(--ill-client); color: var(--ill-client); }
  .curseur { display: grid; gap: 0.25rem; margin-top: 0.5rem; }
  .curseur input { width: 100%; accent-color: var(--accent); }
  .curseur output { font-family: var(--police-mono); font-weight: 700; }
  .matrice { border-collapse: collapse; margin: 0.75rem 0 0.25rem; font-size: 0.95rem; }
  .matrice caption { text-align: left; font-size: 0.85rem; color: var(--muted); margin-bottom: 0.3rem; }
  .matrice th, .matrice td { border: 1px solid var(--border); padding: 0.35rem 0.7rem; text-align: center; }
  .matrice td { font-family: var(--police-mono); font-weight: 700; font-size: 1.05rem; }
  .matrice td.bien { background: color-mix(in oklab, var(--ill-secret-b) 14%, transparent); }
  .matrice td.mal { background: color-mix(in oklab, var(--ill-paquet) 14%, transparent); }
  .matrice thead td { border: none; }
  .cle { font-size: 0.85rem; color: var(--muted); margin: 0.4rem 0 0; }
</style>
