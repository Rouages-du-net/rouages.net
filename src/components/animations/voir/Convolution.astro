---
// Animation « Des filtres pour voir les bords » (étape 1 du module « Les IA
// qui voient ») : on applique à une petite image un noyau de convolution
// 3 × 3 (flou, bords verticaux, horizontaux, contours) et l'on détaille le
// calcul d'un pixel.
import { NOYAUX } from '../../../lib/voir';
---
<div class="anim convolution" data-convolution>
  <div class="anim-repli">
    <p>
      Une convolution fait glisser une petite grille de 3 × 3 coefficients, le « noyau », sur
      toute l'image. Pour chaque pixel, on multiplie ses 9 voisins par les 9 coefficients et
      l'on additionne. Avec des coefficients tous égaux, on obtient un flou. Avec −1 à gauche
      et +1 à droite, le résultat est nul dans les zones unies et fort là où la luminosité
      change : on a détecté les bords verticaux. Les premières couches des réseaux qui voient
      apprennent des filtres de ce genre.
    </p>
  </div>

  <div class="anim-scene" hidden>
    <div class="anim-cadre">
      <fieldset class="choix">
        <legend>Noyau</legend>
        {NOYAUX.map((n, i) => (
          <label><input type="radio" name="convolution-noyau" value={n.id} checked={n.id === 'verticaux'} /> {n.nom}</label>
        ))}
      </fieldset>
      <div class="trois">
        <figure>
          <svg viewBox="0 0 32 32" role="img" aria-label="Image de départ : une maison et un soleil" data-avant></svg>
          <figcaption>Image (32 × 32)</figcaption>
        </figure>
        <figure class="noyau-fig">
          <table class="noyau" aria-label="Coefficients du noyau"><tbody data-noyau></tbody></table>
          <figcaption>Noyau 3 × 3</figcaption>
        </figure>
        <figure>
          <svg viewBox="0 0 32 32" role="img" aria-label="Résultat de la convolution" data-apres></svg>
          <figcaption>Résultat</figcaption>
        </figure>
      </div>
      <p class="calcul" data-calcul></p>
      <p class="anim-legende" aria-live="polite"></p>
      <p class="anim-note">Dans le résultat, l'orange marque les valeurs positives, le bleu les négatives.</p>
    </div>
  </div>
</div>

<script>
  import { activerScene } from '../../../lib/pasapas';
  import { NOYAUX, maison, convoluer, type Image } from '../../../lib/voir';

  const NS = 'http://www.w3.org/2000/svg';
  const fr = (v: number) => (Math.round(v * 100) / 100).toString().replace('.', ',').replace('-', '−');

  function grille(svg: SVGSVGElement, n: number) {
    return Array.from({ length: n * n }, (_, i) => {
      const r = document.createElementNS(NS, 'rect');
      r.setAttribute('x', String(i % n));
      r.setAttribute('y', String(Math.floor(i / n)));
      r.setAttribute('width', '1.02');
      r.setAttribute('height', '1.02');
      svg.append(r);
      return r;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-convolution]').forEach((racine) => {
    activerScene(racine);
    const image = maison();
    const avant = grille(racine.querySelector<SVGSVGElement>('[data-avant]')!, 32);
    const svgApres = racine.querySelector<SVGSVGElement>('[data-apres]')!;
    const apres = grille(svgApres, 32);
    const repere = document.createElementNS(NS, 'rect');
    repere.setAttribute('class', 'repere');
    repere.setAttribute('width', '3');
    repere.setAttribute('height', '3');
    racine.querySelector<SVGSVGElement>('[data-avant]')!.append(repere);
    avant.forEach((r, i) => {
      r.setAttribute('class', 'gris');
      r.setAttribute('fill-opacity', image.px[i].toFixed(2));
    });
    const legende = racine.querySelector<HTMLElement>('.anim-legende')!;
    const calcul = racine.querySelector<HTMLElement>('[data-calcul]')!;
    // Un pixel sur le mur gauche de la maison, pour détailler le calcul.
    const PX = 7, PY = 24;
    repere.setAttribute('x', String(PX - 1));
    repere.setAttribute('y', String(PY - 1));

    function maj() {
      const choix = NOYAUX.find((n) => n.id === racine.querySelector<HTMLInputElement>('input:checked')!.value)!;
      const out: Image = convoluer(image, choix.noyau);
      const max = Math.max(...Array.from(out.px, Math.abs), 1e-9);
      apres.forEach((r, i) => {
        const v = out.px[i] / max;
        r.setAttribute('class', v >= 0 ? 'pos' : 'neg');
        r.setAttribute('fill-opacity', Math.abs(v).toFixed(2));
      });
      racine.querySelector('[data-noyau]')!.innerHTML = [0, 1, 2]
        .map((j) => `<tr>${[0, 1, 2].map((i) => `<td>${fr(choix.noyau[j * 3 + i])}</td>`).join('')}</tr>`)
        .join('');
      const termes: string[] = [];
      let somme = 0;
      for (let j = -1; j <= 1; j++)
        for (let i = -1; i <= 1; i++) {
          const k = choix.noyau[(j + 1) * 3 + i + 1];
          const p = image.px[(PY + j) * 32 + PX + i];
          somme += k * p;
          if (k !== 0) termes.push(`${fr(k)}×${fr(p)}`);
        }
      calcul.textContent = `Pixel encadré : ${termes.join(' + ').replaceAll('+ −', '− ')} = ${fr(somme)}`;
      legende.textContent = choix.explication;
    }
    racine.querySelectorAll('input').forEach((i) => i.addEventListener('change', maj));
    maj();
  });
</script>

<style>
  .choix { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; border: 1px solid var(--border); border-radius: 0.75rem; padding: 0.5rem 0.9rem; margin: 0 0 0.75rem; }
  .choix legend { font-weight: 600; padding: 0 0.3rem; }
  .choix label { font-size: 0.9rem; display: inline-flex; gap: 0.35rem; align-items: center; }
  .trois { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: center; }
  figure { margin: 0; text-align: center; }
  figcaption { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; }
  svg { width: 100%; aspect-ratio: 1; display: block; background: var(--bg); border: 1px solid var(--border); }
  svg :global(rect.gris) { fill: var(--fg); }
  svg :global(rect.pos) { fill: var(--ill-paquet); }
  svg :global(rect.neg) { fill: var(--ill-client); }
  svg :global(rect.repere) { fill: none; stroke: var(--ill-commun); stroke-width: 0.35; }
  .noyau { border-collapse: collapse; font-family: var(--police-mono); font-size: 0.8rem; }
  .noyau :global(td) { border: 1px solid var(--border); padding: 0.2rem 0.35rem; text-align: center; min-width: 1.8rem; }
  .calcul { font-family: var(--police-mono); font-size: 0.75rem; overflow-wrap: anywhere; margin: 0.75rem 0 0; }
  @media (max-width: 30rem) { .trois { grid-template-columns: 1fr 1fr; } .noyau-fig { grid-column: 1 / -1; order: -1; } }
</style>
