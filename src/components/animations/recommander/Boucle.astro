---
// Animation « La boucle de popularité » (étape 3 du module « Les IA qui
// recommandent ») : 12 morceaux de qualités voisines, 1 500 auditeurs.
// Dans un monde, chacun choisit sans voir ce que les autres écoutent ; dans
// l'autre, le classement des plus écoutés pèse sur les choix. On rejoue
// plusieurs « mondes » : avec influence, les écarts se creusent et le
// gagnant change d'un monde à l'autre. Inspiré de l'expérience MusicLab.
---
<div class="anim boucle" data-boucle>
  <div class="anim-repli">
    <p>
      Douze morceaux, de qualités voisines (le n° 1 est un peu meilleur que le n° 2, et ainsi de
      suite). Quand chaque auditeur choisit sans voir ce que les autres écoutent, le meilleur
      morceau gagne presque toujours, et les écarts restent modérés. Quand le classement des
      plus écoutés est affiché et influence les choix, les premiers succès attirent encore plus
      d'écoutes : les écarts deviennent énormes, et le gagnant change d'une fois à l'autre,
      selon les hasards du début.
    </p>
  </div>

  <div class="anim-scene" hidden>
    <div class="anim-cadre">
      <div class="deux">
        <figure>
          <figcaption>Sans classement visible</figcaption>
          <div class="barres" data-monde="0"></div>
          <p class="mesure" data-mesure="0"></p>
        </figure>
        <figure>
          <figcaption>Avec le classement des plus écoutés</figcaption>
          <div class="barres" data-monde="1"></div>
          <p class="mesure" data-mesure="1"></p>
        </figure>
      </div>
      <div class="anim-commandes">
        <button type="button" class="principal" data-action="rejouer">🎲 Rejouer un monde</button>
      </div>
      <p class="historique" data-historique></p>
      <p class="anim-legende" aria-live="polite"></p>
    </div>
  </div>
</div>

<script>
  import { activerScene } from '../../../lib/pasapas';
  import { marche, gini } from '../../../lib/recommander';
  import { hasard } from '../../../lib/minilm';

  const QUALITES = [1.3, 1.25, 1.2, 1.15, 1.1, 1.05, 1.0, 0.95, 0.9, 0.85, 0.8, 0.75];
  const INFLUENCE = [0, 0.95];

  document.querySelectorAll<HTMLElement>('[data-boucle]').forEach((racine) => {
    activerScene(racine);
    const legende = racine.querySelector<HTMLElement>('.anim-legende')!;
    let monde = 0;
    const gagnants: number[][] = [[], []];

    function jouer() {
      monde++;
      INFLUENCE.forEach((inf, k) => {
        const e = marche(QUALITES, 1500, inf, hasard(100 + monde * 7 + k));
        const max = Math.max(...e);
        const g = e.indexOf(max);
        gagnants[k].push(g + 1);
        racine.querySelector(`[data-monde="${k}"]`)!.replaceChildren(
          ...e.map((n, i) => {
            const d = document.createElement('div');
            d.className = `barre${i === g ? ' gagnant' : ''}`;
            d.style.height = `${(n / 1500) * 250}%`;
            d.title = `Morceau n° ${i + 1} : ${n} écoutes`;
            return d;
          }),
        );
        racine.querySelector(`[data-mesure="${k}"]`)!.textContent = `Gagnant : n° ${g + 1} · inégalité (Gini) : ${gini(e).toFixed(2).replace('.', ',')}`;
      });
      racine.querySelector('[data-historique]')!.textContent = `Gagnants des ${monde} monde${monde > 1 ? 's' : ''} joué${monde > 1 ? 's' : ''} — sans classement : ${gagnants[0].join(', ')} · avec classement : ${gagnants[1].join(', ')}`;
      legende.textContent =
        monde < 3
          ? 'Les barres montrent les écoutes de chaque morceau (le n° 1 est le meilleur). Rejoue plusieurs mondes et compare les gagnants.'
          : 'Sans classement visible, le meilleur morceau gagne presque toujours. Avec le classement, les écarts explosent (indice de Gini bien plus haut) et le gagnant dépend des hasards du début. Les recommandations fondées sur la popularité peuvent amplifier ces boucles.';
    }
    racine.querySelector('[data-action="rejouer"]')!.addEventListener('click', jouer);
    jouer();
  });
</script>

<style>
  .deux { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  figure { margin: 0; }
  figcaption { font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem; }
  .barres { display: flex; align-items: flex-end; gap: 3px; height: 8rem; border-bottom: 1px solid var(--border); background: var(--bg); padding: 0 0.3rem; }
  .barres :global(.barre) { flex: 1; background: var(--ill-client); min-height: 2px; max-height: 100%; }
  .barres :global(.barre.gagnant) { background: var(--ill-paquet); }
  .mesure { font-family: var(--police-mono); font-size: 0.8rem; margin: 0.3rem 0 0; }
  .historique { font-size: 0.85rem; color: var(--muted); }
</style>
