---
// Animation « Ce que pèse un téléphone avant d'être allumé » (module « La
// matérialité du numérique », étape 2) : on « démonte » un téléphone, chaque
// pièce révèle sa matière et sa provenance. Données : src/data/materialite.ts.
import { PIECES } from '../../../data/materialite';
---
<div class="anim telephone" data-telephone>
  <div class="anim-repli">
    <dl>
      {PIECES.map((p) => <><dt>{p.piece} : {p.matiere}</dt><dd>{p.texte}</dd></>)}
    </dl>
  </div>

  <div class="anim-scene" hidden>
    <div class="anim-cadre deux-colonnes">
      <div class="boitier" role="group" aria-label="Pièces du téléphone">
        {PIECES.map((p, i) => (
          <button type="button" class={`piece p${i}`} data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="nom">{p.piece}</span>
            <span class="matiere">{p.matiere}</span>
          </button>
        ))}
      </div>
      <div class="fiche-piece">
        <h4 data-titre></h4>
        <p data-texte aria-live="polite"></p>
      </div>
    </div>
  </div>
</div>

<script>
  import { activerScene } from '../../../lib/pasapas';
  import { PIECES } from '../../../data/materialite';

  document.querySelectorAll<HTMLElement>('[data-telephone]').forEach((racine) => {
    activerScene(racine);
    const boutons = [...racine.querySelectorAll<HTMLButtonElement>('.piece')];
    const titre = racine.querySelector<HTMLElement>('[data-titre]')!;
    const texte = racine.querySelector<HTMLElement>('[data-texte]')!;
    const montrer = (i: number) => {
      boutons.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
      titre.textContent = `${PIECES[i].piece} : ${PIECES[i].matiere}`;
      texte.textContent = PIECES[i].texte;
    };
    boutons.forEach((b) => b.addEventListener('click', () => montrer(Number(b.dataset.i))));
    montrer(0);
  });
</script>

<style>
  .deux-colonnes { display: grid; grid-template-columns: minmax(10rem, 14rem) 1fr; gap: 1rem; align-items: start; }
  @media (max-width: 36rem) { .deux-colonnes { grid-template-columns: 1fr; } }
  .boitier { display: grid; gap: 0.4rem; padding: 0.7rem; border: 3px solid var(--fg); border-radius: 1.4rem; background: var(--bg); }
  .piece { font: inherit; text-align: left; display: grid; padding: 0.5rem 0.65rem; border: 1px solid var(--border); border-radius: 0.6rem; background: var(--card); color: var(--fg); cursor: pointer; }
  .piece .nom { font-weight: 700; font-size: 0.92rem; }
  .piece .matiere { font-size: 0.8rem; color: var(--muted); }
  .piece[aria-pressed='true'] { border-color: var(--accent); box-shadow: inset 0.35rem 0 0 var(--accent); }
  .piece:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fiche-piece h4 { margin: 0 0 0.4rem; }
  .fiche-piece p { margin: 0; max-width: var(--mesure); }
</style>
