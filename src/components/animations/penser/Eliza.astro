---
// Animation « Parle à un petit ELIZA » (module « Une machine peut-elle
// penser ? ») : une poignée de règles à mots-clés, comme le programme de
// Joseph Weizenbaum (1966), avec un script français inventé. On peut afficher
// la règle utilisée pour chaque réponse.
---
<div class="anim eliza" data-eliza>
  <div class="anim-repli">
    <p>
      ELIZA repère des mots-clés et renvoie la phrase retournée. À « Je suis triste depuis hier », il
      répond « Pourquoi dis-tu que tu es triste depuis hier ? » ; à « Ma mère ne m'écoute jamais »,
      « Qui d'autre dans ta famille te vient à l'esprit ? ». Quand rien ne correspond, il relance :
      « Peux-tu développer ? ». Une dizaine de règles suffisent à donner l'impression d'une écoute
      attentive.
    </p>
  </div>

  <div class="anim-scene" hidden>
    <div class="anim-cadre">
      <ol class="fil" data-fil aria-live="polite" aria-label="Conversation avec le petit ELIZA"></ol>
      <form class="saisie" data-form>
        <label for="eliza-entree" class="visuellement-cache">Ta phrase</label>
        <input id="eliza-entree" type="text" autocomplete="off" maxlength="160" placeholder="Écris une phrase, par exemple « Je suis fatigué »" data-entree />
        <button type="submit" class="anim-bouton principal">Envoyer</button>
      </form>
      <label class="case"><input type="checkbox" data-regles /> Montrer la règle utilisée pour chaque réponse</label>
      <p class="anim-legende" aria-live="polite"></p>
      <p class="anim-note">Script inventé, en français, sur le principe de 1966 : mots-clés, phrases à trous, « je » changé en « tu ». Rien n'est envoyé : tout se passe dans ton navigateur.</p>
    </div>
  </div>
</div>

<script>
  import { activerScene } from '../../../lib/pasapas';
  import { eliza } from '../../../lib/penser';

  document.querySelectorAll<HTMLElement>('[data-eliza]').forEach((racine) => {
    activerScene(racine);
    const fil = racine.querySelector<HTMLElement>('[data-fil]')!;
    const entree = racine.querySelector<HTMLInputElement>('[data-entree]')!;
    const regles = racine.querySelector<HTMLInputElement>('[data-regles]')!;
    const legende = racine.querySelector<HTMLElement>('.anim-legende')!;
    let tour = 0, sansRegle = 0;

    const bulle = (texte: string, qui: 'toi' | 'eliza', regle?: string) => {
      const li = document.createElement('li');
      li.className = qui;
      li.textContent = `${qui === 'toi' ? 'Toi' : 'ELIZA'} : ${texte}`;
      if (regle) {
        const r = document.createElement('span');
        r.className = 'regle';
        r.textContent = `règle : ${regle}`;
        li.append(r);
      }
      fil.append(li);
      fil.scrollTop = fil.scrollHeight;
    };

    racine.querySelector('[data-form]')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const phrase = entree.value.trim();
      if (!phrase) return;
      bulle(phrase, 'toi');
      const { reponse, regle } = eliza(phrase, tour++);
      if (regle.startsWith('aucune')) sansRegle++;
      bulle(reponse, 'eliza', regle);
      entree.value = '';
      legende.textContent =
        tour < 3
          ? 'Continue un peu. Puis coche la case pour voir comment chaque réponse a été fabriquée.'
          : sansRegle
            ? `En ${tour} échanges, ELIZA n’a rien compris : ${sansRegle} fois, il n’a reconnu aucun mot-clé et a relancé avec une phrase passe-partout. Pourtant, la conversation a l’air d’une écoute.`
            : `En ${tour} échanges, ELIZA n’a rien compris : il a seulement repéré des mots-clés et retourné tes phrases. Pourtant, la conversation a l’air d’une écoute.`;
    });
    regles.addEventListener('input', () => fil.classList.toggle('montre', regles.checked));
    bulle('Bonjour. Qu’est-ce qui t’amène ?', 'eliza');
  });
</script>

<style>
  .fil { list-style: none; padding: 0.5rem; margin: 0 0 0.5rem; max-height: 16rem; overflow-y: auto; display: grid; gap: 0.35rem; background: var(--bg); border-radius: 0.4rem; font-size: 0.95rem; }
  .fil :global(li) { padding: 0.35rem 0.6rem; border-radius: 0.5rem; max-width: 90%; }
  .fil :global(li.toi) { justify-self: end; background: var(--card); border: 1px solid var(--border); }
  .fil :global(li.eliza) { justify-self: start; border: 1px solid var(--accent); }
  .fil :global(.regle) { display: none; font: 0.75rem var(--police-mono); color: var(--muted); margin-top: 0.2rem; }
  .fil.montre :global(.regle) { display: block; }
  .saisie { display: flex; gap: 0.4rem; }
  .saisie input { flex: 1; min-width: 0; font: inherit; padding: 0.4rem 0.6rem; border: 1px solid var(--border); border-radius: 0.4rem; background: var(--bg); color: var(--fg); }
  .case { display: flex; gap: 0.4rem; align-items: baseline; font-size: 0.95rem; margin-top: 0.5rem; }
  .case input { accent-color: var(--accent); }
</style>
