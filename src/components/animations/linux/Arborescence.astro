---
// Animation « Tout part de la racine » (module Linux, étape 0) : une
// arborescence d'exemple (Debian ou Ubuntu récent, réduite) qu'on déplie ;
// chaque dossier donne son chemin absolu et son rôle selon le FHS 3.0 et
// hier(7). Sources : docs/sources/linux.md.
import { ARBRE } from '../../../data/linux';

const premiers = ARBRE.filter((n) => n.chemin !== '/' && n.chemin.split('/').length === 2);
---
<div class="anim arborescence" data-arborescence data-arbre={JSON.stringify(ARBRE)}>
  <div class="anim-repli">
    <p>Sous Linux, tout part d'une seule racine, <code>/</code>. Ses principaux dossiers :</p>
    <dl>
      {premiers.map((n) => (<><dt><code>{n.chemin}</code></dt><dd>{n.role}</dd></>))}
    </dl>
  </div>
  <div class="anim-scene" hidden>
    <div class="anim-cadre">
      <div class="disposition">
        <ul class="arbre" aria-label="Arborescence d'une machine Linux" data-arbre-liste></ul>
        <div class="fiche" aria-live="polite">
          <p class="chemin" data-fiche-chemin></p>
          <p class="role" data-role></p>
          <p class="anim-note" data-cd></p>
        </div>
      </div>
      <div class="anim-commandes">
        <button type="button" data-action="tout">Tout déplier</button>
        <button type="button" data-action="replier">Tout replier</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { activerScene } from '../../../lib/pasapas';

  interface Noeud { chemin: string; role?: string; lien?: string; fichier?: boolean }

  document.querySelectorAll<HTMLElement>('[data-arborescence]').forEach((racine) => {
    activerScene(racine);
    const noeuds: Noeud[] = JSON.parse(racine.dataset.arbre!);
    const liste = racine.querySelector<HTMLUListElement>('[data-arbre-liste]')!;
    const ouverts = new Set<string>(['/']);
    let choisi = '/';
    const parent = (c: string) => (c === '/' ? '' : c.slice(0, c.lastIndexOf('/')) || '/');
    const enfants = (c: string) => noeuds.filter((n) => n.chemin !== '/' && parent(n.chemin) === c);
    const nom = (c: string) => (c === '/' ? '/' : c.slice(c.lastIndexOf('/') + 1));

    function rendre() {
      liste.replaceChildren();
      const ajouter = (n: Noeud, prof: number) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'noeud';
        b.style.paddingLeft = `${0.3 + prof * 1.1}rem`;
        const sous = enfants(n.chemin);
        const icone = n.fichier ? '📄' : n.lien ? '🔗' : ouverts.has(n.chemin) && sous.length ? '📂' : '📁';
        b.textContent = `${icone} ${nom(n.chemin)}${n.fichier || n.chemin === '/' ? '' : '/'}${n.lien ? ` → ${n.lien}` : ''}`;
        b.dataset.chemin = n.chemin;
        if (sous.length) b.setAttribute('aria-expanded', String(ouverts.has(n.chemin)));
        b.setAttribute('aria-pressed', String(n.chemin === choisi));
        if (n.chemin.startsWith('/home/alice/.')) b.classList.add('cache');
        b.addEventListener('click', () => {
          choisi = n.chemin;
          if (sous.length) { if (ouverts.has(n.chemin) && n.chemin !== '/') ouverts.delete(n.chemin); else ouverts.add(n.chemin); }
          rendre();
          liste.querySelector<HTMLButtonElement>(`[data-chemin="${CSS.escape(choisi)}"]`)?.focus();
        });
        li.append(b);
        liste.append(li);
        if (ouverts.has(n.chemin)) for (const e of sous) ajouter(e, prof + 1);
      };
      ajouter(noeuds.find((n) => n.chemin === '/')!, 0);
      const n = noeuds.find((x) => x.chemin === choisi)!;
      racine.querySelector("[data-fiche-chemin]")!.textContent = `${n.fichier ? 'Fichier' : 'Dossier'} ${n.chemin}`;
      racine.querySelector('[data-role]')!.textContent = n.role ?? '';
      racine.querySelector('[data-cd]')!.textContent = n.fichier
        ? `Chemin absolu : ${n.chemin}. On l’affiche avec : cat ${n.chemin}`
        : `Pour y aller, de n’importe où : cd ${n.chemin}`;
    }
    racine.querySelector('[data-action="tout"]')!.addEventListener('click', () => {
      noeuds.forEach((n) => { if (!n.fichier) ouverts.add(n.chemin); });
      rendre();
    });
    racine.querySelector('[data-action="replier"]')!.addEventListener('click', () => {
      ouverts.clear(); ouverts.add('/'); choisi = '/'; rendre();
    });
    rendre();
  });
</script>

<style>
  .disposition { display: grid; grid-template-columns: minmax(13rem, 18rem) 1fr; gap: 1rem; align-items: start; }
  @media (max-width: 40rem) { .disposition { grid-template-columns: 1fr; } }
  .arbre { list-style: none; margin: 0; padding: 0.4rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--bg); max-height: 26rem; overflow-y: auto; font-family: var(--police-mono); font-size: 0.85rem; }
  .arbre :global(.noeud) { display: block; width: 100%; text-align: left; font: inherit; color: var(--fg); background: none; border: 1px solid transparent; border-radius: 0.25rem; padding-block: 0.1rem; cursor: pointer; overflow-wrap: anywhere; }
  .arbre :global(.noeud[aria-pressed='true']) { border-color: var(--accent); font-weight: 700; }
  .arbre :global(.noeud.cache) { color: var(--muted); }
  .fiche { border-left: 4px solid var(--accent-2); padding: 0.2rem 0.8rem; }
  .chemin { margin: 0 0 0.3rem; font-family: var(--police-mono); font-weight: 700; overflow-wrap: anywhere; }
  .role { margin: 0 0 0.5rem; }
  dl { margin: 0; }
  dt { font-weight: 700; margin-top: 0.4rem; }
  dd { margin: 0 0 0 1rem; }
</style>
