---
// Animation « Un neurone artificiel » (étape 3 du module « Les IA qui
// écrivent ») : un perceptron à deux entrées sépare des fruits mûrs et pas mûrs.
// On règle soi-même ses deux poids et son biais, ou on le laisse apprendre
// avec la règle de Rosenblatt (src/lib/minilm.ts).

// Données d'exemple : x = couleur (0 vert → 1 rouge), y = fermeté (0 mou → 1 dur).
const POINTS = [
  [0.1, 0.9, 0], [0.2, 0.7, 0], [0.15, 0.4, 0], [0.3, 0.85, 0], [0.4, 0.75, 0], [0.35, 0.55, 0], [0.55, 0.9, 0],
  [0.65, 0.3, 1], [0.8, 0.45, 1], [0.9, 0.2, 1], [0.75, 0.1, 1], [0.6, 0.15, 1], [0.95, 0.6, 1], [0.5, 0.05, 1],
].map(([x, y, classe]) => ({ x, y, classe }));
const X = (x: number) => 30 + x * 240;
const Y = (y: number) => 250 - y * 230;
---
<div class="anim neurone" data-neurone data-points={JSON.stringify(POINTS)}>
  <div class="anim-repli">
    <p>
      Un neurone artificiel reçoit deux nombres, ici la couleur et la fermeté d'un fruit. Il
      les multiplie par ses deux « poids », ajoute un « biais », et répond 1 (mûr) si le total
      est positif, 0 sinon. Apprendre, c'est ajuster ces trois nombres jusqu'à ce que la ligne
      qui sépare les deux réponses laisse les fruits mûrs d'un côté et les autres de l'autre.
    </p>
  </div>

  <div class="anim-scene" hidden>
    <div class="anim-cadre grille">
      <svg viewBox="0 0 300 280" role="img" aria-labelledby="neurone-titre">
        <title id="neurone-titre">Fruits placés selon leur couleur (horizontal) et leur fermeté (vertical), et la frontière du neurone.</title>
        <polygon class="zone" data-zone points="" />
        <rect x="30" y="20" width="240" height="230" class="cadre" />
        <line class="frontiere" data-frontiere x1="0" y1="0" x2="0" y2="0" />
        {POINTS.map((p, i) => (
          <g class={`fruit c${p.classe}`} data-fruit={i}>
            {p.classe ? <circle cx={X(p.x)} cy={Y(p.y)} r="7" /> : <rect x={X(p.x) - 6} y={Y(p.y) - 6} width="12" height="12" />}
          </g>
        ))}
        <text x="150" y="275" class="axe">couleur : vert → rouge</text>
        <text x="12" y="135" class="axe" transform="rotate(-90 12 135)">fermeté : mou → dur</text>
      </svg>
      <div class="reglages">
        <p class="formule" data-formule aria-live="polite"></p>
        <label>Poids de la couleur <output data-sortie="w1"></output><input type="range" min="-3" max="3" step="0.1" value="0.5" data-w="w1" /></label>
        <label>Poids de la fermeté <output data-sortie="w2"></output><input type="range" min="-3" max="3" step="0.1" value="0.5" data-w="w2" /></label>
        <label>Biais <output data-sortie="b"></output><input type="range" min="-3" max="3" step="0.1" value="0" data-w="b" /></label>
        <div class="anim-commandes">
          <button type="button" class="principal" data-action="apprendre">🎓 Apprendre (une passe)</button>
          <button type="button" data-action="recommencer">↺</button>
        </div>
        <p class="legende-fruits"><span class="cle c1">●</span> mûr <span class="cle c0">■</span> pas mûr</p>
      </div>
    </div>
    <p class="anim-legende" aria-live="polite"></p>
  </div>
</div>

<script>
  import { activerScene } from '../../../lib/pasapas';
  import { neurone, passePerceptron, type Point } from '../../../lib/minilm';

  const X = (x: number) => 30 + x * 240;
  const Y = (y: number) => 250 - y * 230;
  const fr = (v: number) => v.toFixed(1).replace('.', ',').replace(/^-0,0$/, '0,0');

  document.querySelectorAll<HTMLElement>('[data-neurone]').forEach((racine) => {
    activerScene(racine);
    const points: Point[] = JSON.parse(racine.dataset.points!);
    const curseurs = [...racine.querySelectorAll<HTMLInputElement>('[data-w]')];
    const val = (n: string) => Number(racine.querySelector<HTMLInputElement>(`[data-w="${n}"]`)!.value);
    const legende = racine.querySelector<HTMLElement>('.anim-legende')!;
    let passes = 0;

    function dessiner(message?: string) {
      const w1 = val('w1');
      const w2 = val('w2');
      const b = val('b');
      curseurs.forEach((c) => (racine.querySelector(`[data-sortie="${c.dataset.w}"]`)!.textContent = fr(Number(c.value))));
      const terme = (v: number) => (v < 0 ? ` − ${fr(-v)}` : ` + ${fr(v)}`);
      racine.querySelector('[data-formule]')!.textContent = `réponse = 1 si ${fr(w1)} × couleur${terme(w2)} × fermeté${terme(b)} > 0`;
      // Zone « mûr » : on échantillonne les coins et les bords du carré.
      let erreurs = 0;
      racine.querySelectorAll<SVGGElement>('[data-fruit]').forEach((g) => {
        const p = points[Number(g.dataset.fruit)];
        const faux = neurone(w1, w2, b, p.x, p.y) !== p.classe;
        g.classList.toggle('faux', faux);
        if (faux) erreurs++;
      });
      // Frontière w1·x + w2·y + b = 0, coupée au carré [0,1]².
      const pts: [number, number][] = [];
      if (Math.abs(w2) > 1e-9) for (const x of [0, 1]) pts.push([x, -(w1 * x + b) / w2]);
      if (Math.abs(w1) > 1e-9) for (const y of [0, 1]) pts.push([-(w2 * y + b) / w1, y]);
      const dedans = pts.filter(([x, y]) => x >= -1e-9 && x <= 1 + 1e-9 && y >= -1e-9 && y <= 1 + 1e-9);
      const ligne = racine.querySelector<SVGLineElement>('[data-frontiere]')!;
      ligne.style.display = dedans.length >= 2 ? '' : 'none';
      if (dedans.length >= 2) {
        ligne.setAttribute('x1', String(X(dedans[0][0])));
        ligne.setAttribute('y1', String(Y(dedans[0][1])));
        ligne.setAttribute('x2', String(X(dedans[1][0])));
        ligne.setAttribute('y2', String(Y(dedans[1][1])));
      }
      // Zone où le neurone répond « mûr » (polygone des sommets du carré qui
      // sont du bon côté, plus les points de la frontière).
      const coins: [number, number][] = [[0, 0], [1, 0], [1, 1], [0, 1]];
      const zone = [...coins.filter(([x, y]) => w1 * x + w2 * y + b > 0), ...dedans];
      const cx = zone.reduce((s, p) => s + p[0], 0) / (zone.length || 1);
      const cy = zone.reduce((s, p) => s + p[1], 0) / (zone.length || 1);
      zone.sort((p, q) => Math.atan2(p[1] - cy, p[0] - cx) - Math.atan2(q[1] - cy, q[0] - cx));
      racine.querySelector('[data-zone]')!.setAttribute('points', zone.map(([x, y]) => `${X(x)},${Y(y)}`).join(' '));
      legende.textContent =
        message ??
        (erreurs === 0
          ? `Aucune erreur : la ligne sépare parfaitement les fruits mûrs (zone colorée) des autres.`
          : `${erreurs} fruit${erreurs > 1 ? 's' : ''} mal classé${erreurs > 1 ? 's' : ''} (entouré${erreurs > 1 ? 's' : ''}). Bouge les curseurs, ou laisse le neurone apprendre.`);
      return erreurs;
    }

    curseurs.forEach((c) => c.addEventListener('input', () => dessiner()));
    racine.querySelector('[data-action="apprendre"]')!.addEventListener('click', () => {
      const r = passePerceptron({ w1: val('w1'), w2: val('w2'), b: val('b') }, points, 0.3);
      passes++;
      const borne = (v: number) => String(Math.max(-3, Math.min(3, Math.round(v * 10) / 10)));
      (racine.querySelector('[data-w="w1"]') as HTMLInputElement).value = borne(r.w1);
      (racine.querySelector('[data-w="w2"]') as HTMLInputElement).value = borne(r.w2);
      (racine.querySelector('[data-w="b"]') as HTMLInputElement).value = borne(r.b);
      const restantes = dessiner('');
      legende.textContent = `Passe n° ${passes} : pour chaque fruit mal classé, les poids ont été poussés dans la bonne direction. ${
        restantes ? `Encore ${restantes} erreur${restantes > 1 ? 's' : ''} : recommence.` : 'Plus aucune erreur : le neurone a appris.'
      }`;
    });
    racine.querySelector('[data-action="recommencer"]')!.addEventListener('click', () => {
      passes = 0;
      curseurs.forEach((c) => (c.value = c.dataset.w === 'b' ? '0' : '0.5'));
      dessiner();
    });
    dessiner();
  });
</script>

<style>
  .grille { display: grid; grid-template-columns: minmax(14rem, 1.2fr) minmax(13rem, 1fr); gap: 1rem; align-items: center; }
  svg { width: 100%; height: auto; }
  .cadre { fill: none; stroke: var(--border); }
  .zone { fill: color-mix(in oklab, var(--ill-paquet) 14%, transparent); }
  .frontiere { stroke: var(--fg); stroke-width: 2; stroke-dasharray: 6 4; }
  .fruit.c1 circle, .cle.c1 { fill: var(--ill-paquet); color: var(--ill-paquet); }
  .fruit.c0 rect, .cle.c0 { fill: var(--ill-secret-b); color: var(--ill-secret-b); }
  .fruit.faux circle, .fruit.faux rect { stroke: var(--fg); stroke-width: 3; }
  .axe { fill: var(--muted); font: 11px var(--police); text-anchor: middle; }
  .reglages label { display: grid; grid-template-columns: 1fr auto; gap: 0.1rem 0.5rem; font-size: 0.9rem; margin-bottom: 0.5rem; }
  .reglages input { grid-column: 1 / -1; width: 100%; accent-color: var(--accent); }
  .reglages output { font-family: var(--police-mono); }
  .formule { font-family: var(--police-mono); font-size: 0.85rem; margin: 0 0 0.75rem; }
  .legende-fruits { font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 40rem) { .grille { grid-template-columns: 1fr; } }
</style>
