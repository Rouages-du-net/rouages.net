---
// Grille de cartes de modules (page d'accueil). `niveau` : niveau de titre
// des cartes (3 sous une section, 4 sous un groupe), pour une hiérarchie de
// titres correcte. Chaque carte reçoit une couleur de la palette, à tour de
// rôle, pour la bande du haut.
interface Props { modules: [string, string, string?][]; niveau: 3 | 4 }
const { modules, niveau } = Astro.props;
const H = niveau === 3 ? 'h3' : 'h4';
const TEINTES = ['var(--accent)', 'var(--accent-2)', 'var(--ill-secret-b)', 'var(--ill-serveur)', 'var(--ill-secret-a)', 'var(--ill-client)'];
---
<div class="grid">
  {modules.map(([nom, desc, lien], i) => (
    <article class:list={['card', 'carte-module', { bientot: !lien }]} style={`--teinte: ${TEINTES[i % TEINTES.length]}`}>
      <H class="titre-carte">{lien ? <a href={lien}>{nom}</a> : nom}</H>
      <p>{desc}</p>
      <span class="badge">{lien ? '▶ Ouvrir' : '⏳ Bientôt'}</span>
    </article>
  ))}
</div>

<style>
  .carte-module { position: relative; display: flex; flex-direction: column; padding-top: 1.6rem; overflow: hidden; transition: transform 0.18s ease, box-shadow 0.18s ease; }
  .carte-module::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 0.55rem; background: var(--teinte); border-bottom: 2px solid var(--fg); }
  .carte-module:has(a):hover, .carte-module:focus-within { transform: translate(-2px, -2px) rotate(-0.4deg); box-shadow: 6px 6px 0 var(--fg); }
  .titre-carte { margin-top: 0; font-size: 1.22rem; }
  .titre-carte a { color: var(--fg); text-decoration: none; }
  /* Toute la carte est cliquable, mais le lien reste le titre. */
  .titre-carte a::after { content: ''; position: absolute; inset: 0; }
  .titre-carte a:focus-visible { outline: none; }
  .carte-module p { flex: 1; margin: 0.5rem 0 1rem; }
  .badge { align-self: flex-start; font-family: var(--police-pixel); font-size: 0.8rem; padding: 0.15rem 0.5rem; border: 2px solid var(--fg); border-radius: 0.4rem; background: var(--soleil); color: var(--sur-soleil); }
  .bientot { box-shadow: none; border-style: dashed; }
  .bientot .badge { background: transparent; color: var(--muted); border-color: var(--muted); }
  .bientot::before { opacity: 0.35; }
</style>
