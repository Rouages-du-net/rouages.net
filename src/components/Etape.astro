---
// Une étape d'un module (voir aussi src/lib/ecrans.ts : un écran par étape).
// Slots : decouverte, curieux, ingenieur (texte à trois niveaux),
// animation (scène interactive) ou, à défaut, scene (description de
// l'animation à venir), decide, histoire, verifie,
// mythes. Les encarts absents ne sont pas affichés ; les autres sont repliés
// (<details>) pour ne pas surcharger l'écran : on les ouvre à la demande.
import Niveaux from './Niveaux.astro';

interface Props {
  numero: number;
  titre: string;
  ancre: string;
  duree?: string; // ordre de grandeur indicatif, ex. « ~20 ms »
}

const { numero, titre, ancre, duree } = Astro.props;
const s = Astro.slots;
const encarts = [
  { slot: 'histoire', titre: "Un peu d'histoire", icone: '📜' },
  { slot: 'decide', titre: 'Qui décide ?', icone: '🏛️' },
  { slot: 'verifie', titre: 'Vérifie toi-même', icone: '🔎' },
].filter((e) => s.has(e.slot));
const rendus = await Promise.all(encarts.map((e) => s.render(e.slot)));
---
<section class="etape" id={ancre} aria-labelledby={`titre-${ancre}`} data-etape={numero}>
  <header>
    <span class="numero" aria-hidden="true">{numero}</span>
    <h2 id={`titre-${ancre}`}><span class="visuellement-cache">Étape {numero} : </span>{titre}</h2>
    {duree && <span class="duree" title="Ordre de grandeur indicatif">⏱ {duree}</span>}
  </header>

  {s.has('animation') ? (
    <div class="animation">
      <slot name="animation" />
    </div>
  ) : s.has('scene') && (
    <figure class="scene">
      <slot name="scene" />
      <figcaption>Animation à venir</figcaption>
    </figure>
  )}

  <Niveaux>
    <slot name="decouverte" slot="decouverte" />
    <slot name="curieux" slot="curieux" />
    <slot name="ingenieur" slot="ingenieur" />
  </Niveaux>

  {(encarts.length > 0 || s.has('mythes')) && (
    <div class="encarts">
      {encarts.map((e, i) => (
        <details class={`encart encart-${e.slot}`}>
          <summary><span aria-hidden="true">{e.icone}</span> {e.titre}</summary>
          <div class="contenu"><Fragment set:html={rendus[i]} /></div>
        </details>
      ))}
      {s.has('mythes') && (
        <details class="encart mythes">
          <summary><span aria-hidden="true">🤔</span> Idées reçues</summary>
          <div class="contenu"><slot name="mythes" /></div>
        </details>
      )}
    </div>
  )}
</section>

<style>
  .etape {
    padding: 3.5rem 0 4rem;
    border-top: 1px solid var(--border);
    scroll-margin-top: 4.5rem;
  }
  header { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
  h2 { margin: 0; font-size: 1.65rem; }
  h2:focus { outline: none; }
  .numero {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    border: 2px solid var(--fg);
    box-shadow: 3px 3px 0 var(--fg);
    background: var(--soleil);
    color: var(--sur-soleil);
    font-family: var(--police-pixel);
    font-weight: 400;
  }
  .duree { color: var(--muted); font-size: 0.9rem; }
  .animation { margin: 0 0 2.5rem; }
  .scene {
    margin: 0 0 2.5rem;
    padding: 1.25rem;
    border: 2px dashed var(--border);
    border-radius: 0.75rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .scene :global(p) { margin: 0; }
  figcaption { font-size: 0.8rem; margin-top: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .encarts {
    display: grid;
    gap: 0.75rem;
    max-width: var(--mesure);
    margin-top: 2.5rem;
  }
  .encart {
    background: var(--card);
    border: 2px solid var(--fg);
    border-radius: 0.75rem;
    font-size: 0.97rem;
  }
  summary {
    cursor: pointer;
    padding: 0.8rem 1.1rem;
    font-weight: 600;
    border-radius: 0.75rem;
  }
  summary:hover { color: var(--accent); }
  .contenu { padding: 0 1.25rem 1.1rem; }
  .contenu :global(p) { margin: 0 0 0.75rem; }
  .contenu :global(p:last-child) { margin-bottom: 0; }
  .contenu :global(ul) { margin: 0; padding-left: 1.1rem; }
  .contenu :global(li + li) { margin-top: 0.5rem; }
  .encart-verifie :global(code) { white-space: nowrap; }
  .mythes { border-left: 8px solid var(--accent-2); }
</style>
